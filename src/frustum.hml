// frustum.hml — Gribb–Hartmann frustum extraction and volume tests.
//
// Nightshade W1-4 / ENGINE_GAPS G8 tier 1. Six dot products reject a whole
// chunk of the world before a single vertex is transformed; without this, an
// open world pays full projection + clip cost for geometry directly behind the
// player and streaming is impossible.
//
// THE PLANES LIVE IN A FLAT array<f64> OF 24. There is no Frustum object and
// there is no Plane object: one object allocation costs as much as 15–30 flat
// writes (ARCHITECTURE §2.1), and this is read per chunk, per entity and per
// particle emitter every frame.
//
//   index      plane
//    0.. 3     left      each plane is (a, b, c, d) with
//    4.. 7     right     a*x + b*y + c*z + d >= 0  <=>  the point is on the
//    8..11     bottom    INSIDE of that plane. The normals point inward and
//   12..15     top       (a, b, c) is unit length, so the expression is the
//   16..19     near      signed distance in world units — which is what makes
//   20..23     far       the sphere test a single compare against -r.
//
// MATRIX CONVENTION. `p_mvp` is the 16-element ROW-MAJOR array that `vec.hml`
// produces (`mat_mul(projection, view_model)`), indexed m[row*4 + col], the
// same layout `mat_apply` reads. Clip coordinates are therefore
//   x_c = m0 x + m1 y + m2 z + m3       (row 0)
//   y_c = m4 x + m5 y + m6 z + m7       (row 1)
//   z_c = m8 x + m9 y + m10 z + m11     (row 2)
//   w_c = m12 x + m13 y + m14 z + m15   (row 3)
// and the six inside-tests -w_c <= {x_c, y_c, z_c} <= w_c become row3 ± rowN.
// The near plane is row3 + row2, i.e. ndc z >= -1 — the SAME plane `clip.hml`
// tests as z + w >= 0, so frustum culling and near clipping never disagree.
//
// GENERICITY (Nightshade R1). Nothing here knows what a chunk, an entity or a
// world is. It takes a matrix and a bounding volume and returns 0 or 1.
//
// PERFORMANCE CONTRACT (nightshade/CLAUDE.md §4)
//   * `frustum_from_mvp` runs once per frame and writes in place — it never
//     allocates and never returns a new array.
//   * `frustum_sphere` / `frustum_aabb` are hot (one call per chunk / entity).
//     Both are fully unrolled over the six planes: no loop counter, no modulo,
//     and an early return on the first rejecting plane, which is the common
//     answer. Scalar parameters are `p_`-prefixed and copied into typed locals
//     (A1); the result leaves through a named copy-out (A2).
//   * Plane coefficients are read straight out of the array. Per the codegen
//     note in `vec.hml`, an array element read stays boxed even from an
//     `array<f64>`, so each coefficient is read exactly ONCE — copying it into
//     an f64 local first would add a conversion without removing one.
//   * No closures, no `defer`, no `throw`, no allocation on any path.

import { sqrt } from "@stdlib/math";

export let FRUSTUM_PLANES = 6;
export let FRUSTUM_STRIDE = 4;
export let FRUSTUM_LEN    = 24;

// Plane slot indices, for callers that want to inspect one.
export let FP_LEFT   = 0;
export let FP_RIGHT  = 4;
export let FP_BOTTOM = 8;
export let FP_TOP    = 12;
export let FP_NEAR   = 16;
export let FP_FAR    = 20;

// Allocate the one flat plane array. Call ONCE at startup and reuse it every
// frame (A8, N6) — `frustum_from_mvp` overwrites it in place.
export fn frustum_new(): array<f64> {
    let f: array<f64> = [];
    for (let i = 0; i < 24; i++) { f.push(0.0); }
    let out: array<f64> = f;
    return out;
}

// Extract and normalise the six planes of `p_mvp` into `p_f` (24 f64, in
// place). Once per frame, so it is written for clarity, not for speed.
export fn frustum_from_mvp(p_f, p_mvp) {
    let m0: f64  = p_mvp[0];  let m1: f64  = p_mvp[1];  let m2: f64  = p_mvp[2];  let m3: f64  = p_mvp[3];
    let m4: f64  = p_mvp[4];  let m5: f64  = p_mvp[5];  let m6: f64  = p_mvp[6];  let m7: f64  = p_mvp[7];
    let m8: f64  = p_mvp[8];  let m9: f64  = p_mvp[9];  let m10: f64 = p_mvp[10]; let m11: f64 = p_mvp[11];
    let m12: f64 = p_mvp[12]; let m13: f64 = p_mvp[13]; let m14: f64 = p_mvp[14]; let m15: f64 = p_mvp[15];

    // left = row3 + row0
    p_f[0]  = m12 + m0;  p_f[1]  = m13 + m1;  p_f[2]  = m14 + m2;  p_f[3]  = m15 + m3;
    // right = row3 - row0
    p_f[4]  = m12 - m0;  p_f[5]  = m13 - m1;  p_f[6]  = m14 - m2;  p_f[7]  = m15 - m3;
    // bottom = row3 + row1
    p_f[8]  = m12 + m4;  p_f[9]  = m13 + m5;  p_f[10] = m14 + m6;  p_f[11] = m15 + m7;
    // top = row3 - row1
    p_f[12] = m12 - m4;  p_f[13] = m13 - m5;  p_f[14] = m14 - m6;  p_f[15] = m15 - m7;
    // near = row3 + row2
    p_f[16] = m12 + m8;  p_f[17] = m13 + m9;  p_f[18] = m14 + m10; p_f[19] = m15 + m11;
    // far = row3 - row2
    p_f[20] = m12 - m8;  p_f[21] = m13 - m9;  p_f[22] = m14 - m10; p_f[23] = m15 - m11;

    for (let i = 0; i < 6; i++) {
        let b: i32 = i * 4;
        let a: f64 = p_f[b];
        let bb: f64 = p_f[b + 1];
        let c: f64 = p_f[b + 2];
        let len: f64 = sqrt(a * a + bb * bb + c * c);
        // A degenerate matrix would give len == 0; leave that plane alone
        // rather than producing NaNs that silently cull everything.
        if (len > 0.0) {
            let inv: f64 = 1.0 / len;
            p_f[b]     = a * inv;
            p_f[b + 1] = bb * inv;
            p_f[b + 2] = c * inv;
            p_f[b + 3] = p_f[b + 3] * inv;
        }
    }
}

// Sphere test. Returns 1 if the sphere is at least partly inside the frustum
// (draw it), 0 if it is wholly outside (cull it).
//
// Conservative in the standard way: a sphere that straddles two planes near a
// corner can report 1 while being empty of frustum. That costs a wasted draw,
// never a missing one.
//
// TEST ORDER IS NEAR, LEFT, RIGHT, BOTTOM, TOP, FAR — not the storage order.
// An array element read costs ~11 ns on this toolchain (measured: 4 reads +
// 4 adds = 45.5 ns/iteration, `hemlockc -O1`), so the plane that rejects
// decides the price: rejecting on the first plane reads 4 coefficients, on the
// last it reads 24. In an open world the single biggest population of culled
// volumes is "behind the player", and the near plane rejects all of them, so
// near is tested first. Measured on the 5x5 ring sweep below this is worth
// ~35 % of the mean per-chunk cost.
export fn frustum_sphere(p_f: array<f64>, p_cx: f64, p_cy: f64, p_cz: f64, p_r: f64): i32 {
    let x: f64 = p_cx; let y: f64 = p_cy; let z: f64 = p_cz;
    let nr: f64 = 0.0 - p_r;
    if (p_f[16] * x + p_f[17] * y + p_f[18] * z + p_f[19] < nr) { let r0: i32 = 0; return r0; }
    if (p_f[0]  * x + p_f[1]  * y + p_f[2]  * z + p_f[3]  < nr) { let r1: i32 = 0; return r1; }
    if (p_f[4]  * x + p_f[5]  * y + p_f[6]  * z + p_f[7]  < nr) { let r2: i32 = 0; return r2; }
    if (p_f[8]  * x + p_f[9]  * y + p_f[10] * z + p_f[11] < nr) { let r3: i32 = 0; return r3; }
    if (p_f[12] * x + p_f[13] * y + p_f[14] * z + p_f[15] < nr) { let r4: i32 = 0; return r4; }
    if (p_f[20] * x + p_f[21] * y + p_f[22] * z + p_f[23] < nr) { let r5: i32 = 0; return r5; }
    let out: i32 = 1;
    return out;
}

// Axis-aligned box test, positive-vertex ("n-vertex") form: for each plane pick
// the box corner furthest along the inward normal; if even that corner is
// behind the plane the whole box is. Returns 1 = keep, 0 = cull.
export fn frustum_aabb(p_f: array<f64>, p_minx: f64, p_miny: f64, p_minz: f64,
                            p_maxx: f64, p_maxy: f64, p_maxz: f64): i32 {
    let nx: f64 = p_minx; let ny: f64 = p_miny; let nz: f64 = p_minz;
    let xx: f64 = p_maxx; let xy: f64 = p_maxy; let xz: f64 = p_maxz;
    for (let i = 0; i < 6; i++) {
        let b: i32 = i * 4;
        let a: f64 = p_f[b];
        let bb: f64 = p_f[b + 1];
        let c: f64 = p_f[b + 2];
        let px: f64 = nx; if (a >= 0.0) { px = xx; }
        let py: f64 = ny; if (bb >= 0.0) { py = xy; }
        let pz: f64 = nz; if (c >= 0.0) { pz = xz; }
        if (a * px + bb * py + c * pz + p_f[b + 3] < 0.0) { let r: i32 = 0; return r; }
    }
    let out: i32 = 1;
    return out;
}
