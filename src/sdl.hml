// sdl.hml — a minimal SDL2 binding for presenting a software framebuffer.
//
// Wobbleweed renders into a plain RGB byte buffer (the framebuffer). This module
// is the *output sink*: it opens a window, uploads the framebuffer to a
// streaming texture each frame, and presents it — plus event polling for quit
// and keys. SDL is reached through Hemlock's FFI (`extern fn`), so the only
// dependency is `libSDL2-2.0.so.0` at runtime.
//
// The framebuffer is width*height*3 bytes, 24-bit RGB, row-major — which maps
// directly to SDL's RGB24 texture format (no conversion).

import "libSDL2-2.0.so.0";

extern fn SDL_Init(flags: u32): i32;
extern fn SDL_CreateWindow(title: string, x: i32, y: i32, w: i32, h: i32, flags: u32): ptr;
extern fn SDL_CreateRenderer(win: ptr, index: i32, flags: u32): ptr;
extern fn SDL_CreateTexture(ren: ptr, format: u32, access: i32, w: i32, h: i32): ptr;
extern fn SDL_RenderSetLogicalSize(ren: ptr, w: i32, h: i32): i32;
extern fn SDL_UpdateTexture(tex: ptr, rect: ptr, pixels: ptr, pitch: i32): i32;
extern fn SDL_SetTextureScaleMode(tex: ptr, mode: i32): i32;
extern fn SDL_SetRenderDrawColor(ren: ptr, r: i32, g: i32, b: i32, a: i32): i32;
extern fn SDL_RenderClear(ren: ptr): i32;
extern fn SDL_RenderCopy(ren: ptr, tex: ptr, src: ptr, dst: ptr): i32;
extern fn SDL_RenderGeometry(ren: ptr, tex: ptr, verts: ptr, nv: i32, idx: ptr, ni: i32): i32;
extern fn SDL_RenderReadPixels(ren: ptr, rect: ptr, fmt: u32, px: ptr, pitch: i32): i32;
extern fn SDL_RenderPresent(ren: ptr): void;
extern fn SDL_PollEvent(ev: ptr): i32;
extern fn SDL_GetKeyboardState(numkeys: ptr): ptr;
extern fn SDL_Delay(ms: u32): void;
extern fn SDL_GetTicks(): u32;
extern fn SDL_GetError(): string;
extern fn SDL_DestroyTexture(tex: ptr): void;
extern fn SDL_DestroyRenderer(ren: ptr): void;
extern fn SDL_DestroyWindow(win: ptr): void;
extern fn SDL_Quit(): void;

// --- constants ---
let SDL_INIT_VIDEO = 32;
let SDL_WINDOWPOS_CENTERED = 805240832;       // 0x2FFF0000
let SDL_WINDOW_SHOWN = 4;
let SDL_RENDERER_ACCELERATED = 2;
let SDL_RENDERER_SOFTWARE = 1;
let SDL_PIXELFORMAT_RGB24 = 386930691;        // byte order R,G,B
let SDL_TEXTUREACCESS_STATIC = 0;
let SDL_TEXTUREACCESS_STREAMING = 1;
let SDL_SCALEMODE_NEAREST = 0;
let SDL_QUIT = 256;                            // 0x100
let SDL_KEYDOWN = 768;                         // 0x300
let EVENT_SIZE = 256;                          // SDL_Event is 56 bytes; over-allocate
let KEYSYM_SYM_OFFSET = 20;                    // SDL_KeyboardEvent.keysym.sym

// Common key codes (SDLK_*)
export let KEY_ESCAPE = 27;
export let KEY_SPACE = 32;
export let KEY_LEFT = 1073741904;
export let KEY_RIGHT = 1073741903;
export let KEY_UP = 1073741906;
export let KEY_DOWN = 1073741905;
export let KEY_W = 119;
export let KEY_A = 97;
export let KEY_S = 115;
export let KEY_D = 100;

// SDL_Scancode values, for held-key polling via SDL_GetKeyboardState.
export let SC_A = 4;  export let SC_D = 7;  export let SC_E = 8;
export let SC_Q = 20; export let SC_S = 22; export let SC_W = 26;
export let SC_RIGHT = 79; export let SC_LEFT = 80; export let SC_DOWN = 81; export let SC_UP = 82;
export let SC_LSHIFT = 225; export let SC_SPACE = 44;

// Open a window sized width*height, scaled up by `scale` (nearest, chunky).
// Returns { win, ren, tex, ev, width, height } or null on failure.
export fn window_open(title: string, width: i32, height: i32, scale: i32): object {
    if (SDL_Init(SDL_INIT_VIDEO) != 0) {
        eprint(`SDL_Init failed: ${SDL_GetError()}`);
        return null;
    }
    let win = SDL_CreateWindow(title, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
                               width * scale, height * scale, SDL_WINDOW_SHOWN);
    if (win == null) { eprint(`CreateWindow failed: ${SDL_GetError()}`); return null; }

    // flags=0 lets SDL pick the best driver: GPU-accelerated on a real display,
    // software when headless. (Do NOT force SDL_RENDERER_ACCELERATED — under the
    // dummy driver the compiler backend gets a renderer that fails
    // SDL_RenderGeometry with "Invalid renderer"; flags=0 behaves identically in
    // the interpreter and compiler.) Fall back to explicit software if needed.
    let ren = SDL_CreateRenderer(win, -1, 0);
    if (ren == null) { ren = SDL_CreateRenderer(win, -1, SDL_RENDERER_SOFTWARE); }
    if (ren == null) { eprint(`CreateRenderer failed: ${SDL_GetError()}`); return null; }
    // Logical size = internal resolution; SDL scales it up to the window.
    SDL_RenderSetLogicalSize(ren, width, height);

    let tex = SDL_CreateTexture(ren, SDL_PIXELFORMAT_RGB24, SDL_TEXTUREACCESS_STREAMING, width, height);
    if (tex == null) { eprint(`CreateTexture failed: ${SDL_GetError()}`); return null; }

    return { win: win, ren: ren, tex: tex, ev: alloc(EVENT_SIZE),
             width: width, height: height };
}

// Push the framebuffer (a raw ptr to width*height*3 RGB bytes) to the screen.
export fn present(w: object, pixels: ptr) {
    SDL_UpdateTexture(w.tex, null, pixels, w.width * 3);
    SDL_RenderClear(w.ren);
    SDL_RenderCopy(w.ren, w.tex, null, null);
    SDL_RenderPresent(w.ren);
}

// --- GPU geometry path (SDL_RenderGeometry) ---

// Upload a Wobbleweed texture ({ width, height, data: buffer }) to a static SDL
// texture sampled with nearest (chunky). Returns the SDL_Texture ptr.
export fn upload_texture(w: object, tex: object): ptr {
    let t = SDL_CreateTexture(w.ren, SDL_PIXELFORMAT_RGB24, SDL_TEXTUREACCESS_STATIC,
                              tex.width, tex.height);
    SDL_UpdateTexture(t, null, buffer_ptr(tex.data), tex.width * 3);
    SDL_SetTextureScaleMode(t, SDL_SCALEMODE_NEAREST);
    return t;
}

// Clear the renderer to a solid color (start of a GPU frame).
export fn clear(w: object, r: i32, g: i32, b: i32) {
    SDL_SetRenderDrawColor(w.ren, r, g, b, 255);
    SDL_RenderClear(w.ren);
}

// Draw `nverts` packed SDL_Vertex (20 bytes each) from `vbuf` with `sdltex`
// (null = untextured, vertex colors only).
export fn draw_tris(w: object, sdltex, vbuf: ptr, nverts: i32) {
    SDL_RenderGeometry(w.ren, sdltex, vbuf, nverts, null, 0);
}

// Present the GPU frame.
export fn present_geom(w: object) { SDL_RenderPresent(w.ren); }

// Read the rendered frame back into `dst` (a width*height*3 RGB buffer) — used
// for headless PNG verification.
export fn read_pixels(w: object, dst) {
    SDL_RenderReadPixels(w.ren, null, SDL_PIXELFORMAT_RGB24, buffer_ptr(dst), w.width * 3);
}

// Drain pending events. Returns { quit: bool, keys: array<i32> } where `keys`
// are the SDLK codes pressed this frame.
export fn poll(w: object): object {
    let quit = false;
    let keys = [];
    while (SDL_PollEvent(w.ev) != 0) {
        let etype = ptr_deref_u32(w.ev);
        if (etype == SDL_QUIT) {
            quit = true;
        } else if (etype == SDL_KEYDOWN) {
            let sym = ptr_deref_u32(ptr_offset(w.ev, KEYSYM_SYM_OFFSET, 1));
            keys.push(sym);
            if (sym == KEY_ESCAPE) { quit = true; }
        }
    }
    return { quit: quit, keys: keys };
}

// Continuous (held) keyboard state — call after poll() each frame. Returns a
// pointer into SDL's scancode→pressed(0/1) array; query with held(state, SC_*).
export fn keystate(): ptr { return SDL_GetKeyboardState(null); }
export fn held(state: ptr, scancode: i32): bool {
    return ptr_deref_u8(ptr_offset(state, scancode, 1)) != 0;
}

export fn ticks(): i32 { return SDL_GetTicks(); }
export fn delay(ms: i32) { SDL_Delay(ms); }

export fn window_close(w: object) {
    SDL_DestroyTexture(w.tex);
    SDL_DestroyRenderer(w.ren);
    SDL_DestroyWindow(w.win);
    SDL_Quit();
}
