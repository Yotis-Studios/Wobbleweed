// clip.hml — near-plane and guard-band clipping.
//
// TWO APIs LIVE HERE.
//
//   * The SHIPPING API (Nightshade W1-4 / ENGINE_GAPS G7). The fast path is a
//     pure predicate returning CLIP_IN / CLIP_OUT / CLIP_STRADDLE. It takes
//     scalars, returns an i32, allocates NOTHING and calls nothing. The rare
//     straddling case falls through to a slow path that writes flat f64 records
//     into a CALLER-OWNED array and holds no closures. Nothing in this file
//     returns `[[a,b,c]]` any more on the shipping path.
//
//   * The LEGACY API (`clip_tri_near`, `clip_tri_rect`), unchanged in name,
//     arity and produced value, because `src/scene_gpu.hml` and
//     `examples/bench_scale.hml` still import it. It allocates two arrays per
//     accepted triangle; that is exactly the cost G7 exists to remove, so do
//     not use it in new code. `examples/probe_clip.hml` diffs the new slow path
//     against it on 10 000 seeded straddling triangles.
//
// WHY CLIP AT ALL
// Projecting a vertex at or behind the camera plane is meaningless (the
// perspective divide blows up or flips it). For a right-handed GL-style
// projection the near plane is ndc z = -1, i.e. clip-space z + w = 0;
// everything kept satisfies z + w >= EPS, so w is safely positive afterwards.
// Near-clipped slivers can still project thousands of pixels off-screen, and
// SDL's software rasteriser silently rejects triangles that big (its
// fixed-point cross products overflow), so projected triangles are then clipped
// against a guard-band rectangle a couple of screens larger than the viewport.
// Attributes lerp linearly in screen space, which restricts the original
// triangle's affine mapping exactly — the cuts are invisible and the PS1
// texture warble is untouched.
//
// BUFFER LAYOUT (the whole shipping interface — there are no structs)
//
//   Near-plane / clip-space vertex, CLIPV_STRIDE = 7 f64:
//       +0 x   +1 y   +2 z   +3 w   +4 u   +5 v   +6 l
//     `l` is a scalar light/shade term. It is only ever lerped, so a caller may
//     use it for anything that interpolates linearly (the engine names nothing).
//
//   Screen-space vertex, SCRV_STRIDE = 8 f64:
//       +0 x   +1 y   +2 z   +3 u   +4 v   +5 r   +6 g   +7 b
//     r/g/b are 0..255 and are TRUNCATED with i32() after each lerp, exactly as
//     the legacy path did, so the two agree bit-for-bit.
//
//   A triangle is 3 consecutive vertices. `clip_*_slow` writes
//   `tris * 3 * STRIDE` f64 into `p_out` starting at `p_off` and returns the
//   triangle count, or -1 if `p_out` does not have room (nothing is written).
//   -1 is the same "drop it and count it" contract `batch_reserve` uses; it
//   never writes past the end.
//
// PERFORMANCE CONTRACT (nightshade/CLAUDE.md §4)
//   * `clip_near_status` / `clip_rect_status` take only `f64` scalars so
//     hemlockc can unbox every operand; parameters are `p_`-prefixed and copied
//     into typed locals (A1); the status leaves through a named copy-out (A2).
//   * EPS is spelled as a literal inside the hot predicates — a top-level `let`
//     read is a boxed global load (CLAUDE.md §1 rule 3).
//   * No closures anywhere in this file except inside the legacy functions.
//     A closure literal de-optimises the whole enclosing block (§1 rule 8),
//     which is why `clip_half` could never be on the shipping path.
//   * The slow paths use module-level scratch arrays allocated once (A8), so
//     even the slow path allocates nothing per call.
//
// ---------------------------------------------------------------------------
// MEASURED: WHY THE ACCEPT PATH COSTS WHAT IT COSTS (read before "optimising")
// ---------------------------------------------------------------------------
// The W1-4 target was < 40 ns/triangle for the accept path. The predicates
// below are, by measurement, the fastest formulations reachable from Hemlock,
// and they land at ~64 ns (near) + ~136 ns (rect) = ~200 ns/triangle compiled
// -O1 — down from ~248 ns + ~630 ns for the legacy object path, a 4.4x cut
// worth ~1.7 ms/frame at 2500 triangles, but not 40 ns.
//
// 40 ns is not reachable THROUGH A FUNCTION CALL on this toolchain. Two facts,
// both measured on `hemlockc` at /home/nbeerbower/Projects/hemlock (see
// `examples/probe_clip.hml` and the report for W1-4):
//
//   1. A function call with an EMPTY body costs 17.2 ns at 6 `f64` parameters
//      and 26.1 ns at 10. Two calls per triangle therefore have a ~50 ns floor
//      before either body executes a single instruction. `probe_clip.hml`
//      re-measures this floor on every run and asserts it exceeds 40 ns.
//   2. hemlockc's inliner (`is_function_inlinable`, `codegen.c:1360`) only
//      fires when the callee's body is EXACTLY ONE return statement of <= 30
//      AST nodes, AND the call is not through an import binding, AND the call
//      site is not itself inside a module (`codegen_call.c:3164`:
//      `!import_binding && !ctx->current_module`). A function exported from
//      clip.hml and called from emit.hml fails on both counts, so it can never
//      be inlined no matter how it is written.
//
// Everything that was tried and rejected, ns/triangle, 4 M calls, -O1:
//      near, `&&` + early-out branches (KEPT)                   55
//      near, params copied to typed locals first                59
//      near, early `return` per branch                          60
//      near, popcount-then-map arithmetic                       92
//      near, one fused return expression                       156
//      rect, params copied + `&&` chain (KEPT)                 128
//      rect, bounding-box min/max form                         141
//      rect, parameters read directly, no copies               182
// The pattern: every SOURCE STATEMENT round-trips its value through an
// `HmlValue` (`hml_val_f64` / `hml_to_f64` / `hml_release`), so cost tracks
// statement count, and a parameter read costs about as much as an arithmetic
// op. Copying a parameter into a typed local pays only when the parameter is
// read three or more times — which is why the rect predicate copies all ten
// and the near predicate copies none.
//
// IF YOU NEED THE 40 ns: write the test inline at the call site. That is the
// project's own rule (nightshade/CLAUDE.md N9, "if you need it inlined, write
// it inline"), and it is the only thing that removes the 43 ns call floor.
// The two tests are three lines each; `emit.hml` may paste them verbatim and
// this file stays the single definition of record:
//
//     // near: d = z + w, cut at EPS so the divide cannot produce infinity
//     let da: f64 = az + aw; let db: f64 = bz + bw; let dc: f64 = cz + cw;
//     if (da > 0.000001 && db > 0.000001 && dc > 0.000001)      -> CLIP_IN
//     else if (da <= 0.000001 && db <= 0.000001 && dc <= 0.000001) -> CLIP_OUT
//     else                                                      -> CLIP_STRADDLE
//
//     // guard band, rect [x0,x1] x [y0,y1]
//     if (ax >= x0 && ax <= x1 && ay >= y0 && ay <= y1 &&
//         bx >= x0 && bx <= x1 && by >= y0 && by <= y1 &&
//         cx >= x0 && cx <= x1 && cy >= y0 && cy <= y1)          -> CLIP_IN
//     else if ((ax < x0 && bx < x0 && cx < x0) || (ax > x1 && bx > x1 && cx > x1) ||
//              (ay < y0 && by < y0 && cy < y0) || (ay > y1 && by > y1 && cy > y1))
//                                                               -> CLIP_OUT
//     else                                                      -> CLIP_STRADDLE
//
// An inlined copy MUST keep the same thresholds and the same comparison
// senses, or it will disagree with `clip_near_slow` / `clip_rect_slow` and the
// slow path will be handed triangles it was told could not occur.
// `probe_clip.hml` asserts that agreement on every seeded triangle.

// ---------------------------------------------------------------------------
// status codes
// ---------------------------------------------------------------------------

export let CLIP_OUT      = 0;   // trivially rejected: emit nothing
export let CLIP_IN       = 1;   // trivially accepted: emit unchanged, no copy
export let CLIP_STRADDLE = 2;   // needs the slow path

// ---------------------------------------------------------------------------
// vertex record strides
// ---------------------------------------------------------------------------

export let CLIPV_STRIDE = 7;    // x y z w u v l   (clip space, near plane)
export let SCRV_STRIDE  = 8;    // x y z u v r g b (screen space, guard band)

// The near plane is cut at d = EPS rather than d = 0 so the surviving w is
// strictly positive and the perspective divide cannot produce an infinity.
let g_CLIP_EPS = 0.000001;

// ---------------------------------------------------------------------------
// scratch — allocated once, reused forever (A8, N6). Never resized.
// ---------------------------------------------------------------------------

fn clip_zeros(n: i32): array<f64> {
    let a: array<f64> = [];
    for (let i = 0; i < n; i++) { a.push(0.0); }
    let out: array<f64> = a;
    return out;
}

// near clip: at most 4 vertices survive, 7 f64 each
let g_clip_np: array<f64> = clip_zeros(28);
let g_clip_nd: array<f64> = clip_zeros(3);
// rect clip: a triangle against 4 half-planes yields at most 7 vertices; 8 f64
// each, with slack.
let g_clip_pa: array<f64> = clip_zeros(80);
let g_clip_pb: array<f64> = clip_zeros(80);

// ===========================================================================
// FAST PATH — pure predicates. No allocation, no call, no branch on memory.
// ===========================================================================

// Near-plane status of the clip-space triangle whose vertices have the given
// (z, w). d = z + w > 0 means "in front of the near plane".
//
//   all three in front         -> CLIP_IN
//   none in front              -> CLIP_OUT
//   otherwise                  -> CLIP_STRADDLE
//
// The thresholds are identical to `clip_near_slow`, so a CLIP_IN answer means
// the slow path would have returned the triangle unchanged and a CLIP_OUT
// answer means it would have returned nothing.
export fn clip_near_status(p_az: f64, p_aw: f64,
                           p_bz: f64, p_bw: f64,
                           p_cz: f64, p_cw: f64): i32 {
    let da: f64 = p_az + p_aw;
    let db: f64 = p_bz + p_bw;
    let dc: f64 = p_cz + p_cw;
    let st: i32 = 2;
    if (da > 0.000001 && db > 0.000001 && dc > 0.000001) {
        st = 1;
    } else {
        if (da <= 0.000001 && db <= 0.000001 && dc <= 0.000001) { st = 0; }
    }
    let out: i32 = st;
    return out;
}

// Guard-band status of a projected triangle against [x0,x1] x [y0,y1].
//
//   all three vertices inside                       -> CLIP_IN
//   all three strictly outside the SAME edge        -> CLIP_OUT
//   otherwise                                       -> CLIP_STRADDLE
//
// The reject is the standard conservative outcode test: a triangle can be
// wholly outside the rectangle without failing it, in which case the slow path
// runs and returns 0 triangles. That is still correct, just not free.
export fn clip_rect_status(p_ax: f64, p_ay: f64,
                           p_bx: f64, p_by: f64,
                           p_cx: f64, p_cy: f64,
                           p_x0: f64, p_y0: f64,
                           p_x1: f64, p_y1: f64): i32 {
    let ax: f64 = p_ax; let ay: f64 = p_ay;
    let bx: f64 = p_bx; let by: f64 = p_by;
    let cx: f64 = p_cx; let cy: f64 = p_cy;
    let x0: f64 = p_x0; let y0: f64 = p_y0;
    let x1: f64 = p_x1; let y1: f64 = p_y1;
    let st: i32 = 2;
    if (ax >= x0 && ax <= x1 && ay >= y0 && ay <= y1 &&
        bx >= x0 && bx <= x1 && by >= y0 && by <= y1 &&
        cx >= x0 && cx <= x1 && cy >= y0 && cy <= y1) {
        st = 1;
    } else {
        if ((ax < x0 && bx < x0 && cx < x0) ||
            (ax > x1 && bx > x1 && cx > x1) ||
            (ay < y0 && by < y0 && cy < y0) ||
            (ay > y1 && by > y1 && cy > y1)) { st = 0; }
    }
    let out: i32 = st;
    return out;
}

// ===========================================================================
// SLOW PATH — rare, allowed to be slow, still allocation-free.
// ===========================================================================

// Sutherland–Hodgman of one clip-space triangle against the near plane.
//
//   p_in  : >= 21 f64, three CLIPV_STRIDE vertices, read from index 0
//   p_out : caller-owned; receives tris * 21 f64 at p_off
//   returns 0, 1 or 2 triangles, or -1 if p_out lacks room (nothing written)
//
// Winding is preserved. Geometry is bit-identical to the legacy
// `clip_tri_near` — same cut parameter, same vertex emission order, same fan.
export fn clip_near_slow(p_in, p_out, p_off: i32): i32 {
    let off: i32 = p_off;
    let cap: i32 = p_out.length;

    let da: f64 = p_in[2]  + p_in[3];
    let db: f64 = p_in[9]  + p_in[10];
    let dc: f64 = p_in[16] + p_in[17];
    let eps: f64 = 0.000001;

    // trivially accepted — copy through unchanged
    if (da > eps && db > eps && dc > eps) {
        if (off + 21 > cap) { let bad: i32 = -1; return bad; }
        for (let k = 0; k < 21; k++) { p_out[off + k] = p_in[k]; }
        let one: i32 = 1;
        return one;
    }
    if (da <= eps && db <= eps && dc <= eps) { let zero: i32 = 0; return zero; }

    g_clip_nd[0] = da; g_clip_nd[1] = db; g_clip_nd[2] = dc;

    let n: i32 = 0;
    for (let i = 0; i < 3; i++) {
        let j: i32 = i + 1;
        if (j == 3) { j = 0; }
        let di: f64 = g_clip_nd[i];
        let dj: f64 = g_clip_nd[j];
        let bi: i32 = i * 7;
        let bj: i32 = j * 7;
        if (di > eps) {
            let d: i32 = n * 7;
            for (let k = 0; k < 7; k++) { g_clip_np[d + k] = p_in[bi + k]; }
            n = n + 1;
        }
        if ((di > eps && dj <= eps) || (di <= eps && dj > eps)) {
            let t: f64 = (di - eps) / (di - dj);
            let d2: i32 = n * 7;
            for (let k2 = 0; k2 < 7; k2++) {
                let va: f64 = p_in[bi + k2];
                let vb: f64 = p_in[bj + k2];
                g_clip_np[d2 + k2] = va + (vb - va) * t;
            }
            n = n + 1;
        }
    }

    // 3 or 4 vertices survive; fan-triangulate from vertex 0
    let tris: i32 = 0;
    if (n >= 3) { tris = n - 2; }
    if (tris == 0) { let zero2: i32 = 0; return zero2; }
    if (off + tris * 21 > cap) { let bad2: i32 = -1; return bad2; }

    let w: i32 = off;
    for (let k3 = 2; k3 < n; k3++) {
        let s0: i32 = 0;
        let s1: i32 = (k3 - 1) * 7;
        let s2: i32 = k3 * 7;
        for (let q = 0; q < 7; q++) { p_out[w + q]      = g_clip_np[s0 + q]; }
        for (let q1 = 0; q1 < 7; q1++) { p_out[w + 7 + q1]  = g_clip_np[s1 + q1]; }
        for (let q2 = 0; q2 < 7; q2++) { p_out[w + 14 + q2] = g_clip_np[s2 + q2]; }
        w = w + 21;
    }
    let out: i32 = tris;
    return out;
}

// One Sutherland–Hodgman half-plane pass over screen-space vertices.
// edge 0: x >= x0   1: x <= x1   2: y >= y0   3: y <= y1
// Returns the vertex count written into p_dst. No closures (that is the point).
fn clip_half_flat(p_src, p_n: i32, p_dst, p_edge: i32,
                  p_x0: f64, p_y0: f64, p_x1: f64, p_y1: f64): i32 {
    let n: i32 = p_n;
    let edge: i32 = p_edge;
    let x0: f64 = p_x0; let y0: f64 = p_y0;
    let x1: f64 = p_x1; let y1: f64 = p_y1;
    let m: i32 = 0;
    for (let i = 0; i < n; i++) {
        let j: i32 = i + 1;
        if (j == n) { j = 0; }
        let bi: i32 = i * 8;
        let bj: i32 = j * 8;
        let di: f64 = 0.0;
        let dj: f64 = 0.0;
        if (edge == 0) { di = p_src[bi]     - x0; dj = p_src[bj]     - x0; }
        if (edge == 1) { di = x1 - p_src[bi];     dj = x1 - p_src[bj];     }
        if (edge == 2) { di = p_src[bi + 1] - y0; dj = p_src[bj + 1] - y0; }
        if (edge == 3) { di = y1 - p_src[bi + 1]; dj = y1 - p_src[bj + 1]; }
        if (di >= 0.0) {
            let d: i32 = m * 8;
            for (let k = 0; k < 8; k++) { p_dst[d + k] = p_src[bi + k]; }
            m = m + 1;
        }
        if ((di >= 0.0 && dj < 0.0) || (di < 0.0 && dj >= 0.0)) {
            let t: f64 = di / (di - dj);
            let d2: i32 = m * 8;
            for (let k2 = 0; k2 < 5; k2++) {
                let va: f64 = p_src[bi + k2];
                let vb: f64 = p_src[bj + k2];
                p_dst[d2 + k2] = va + (vb - va) * t;
            }
            // r/g/b truncate to integers, exactly as the legacy lerp did
            for (let k3 = 5; k3 < 8; k3++) {
                let vc: f64 = p_src[bi + k3];
                let vd: f64 = p_src[bj + k3];
                p_dst[d2 + k3] = f64(i32(vc + (vd - vc) * t));
            }
            m = m + 1;
        }
    }
    let out: i32 = m;
    return out;
}

// Guard-band clip of one projected triangle against [x0,x1] x [y0,y1].
//
//   p_in  : >= 24 f64, three SCRV_STRIDE vertices, read from index 0
//   p_out : caller-owned; receives tris * 24 f64 at p_off
//   returns 0..5 triangles, or -1 if p_out lacks room (nothing written)
//
// Geometry is bit-identical to the legacy `clip_tri_rect`: same edge order
// (x0, x1, y0, y1), same inclusive `>= 0` keep test, same cut parameter, same
// i32 truncation of the colour lerp, same fan from vertex 0.
export fn clip_rect_slow(p_in, p_x0: f64, p_y0: f64, p_x1: f64, p_y1: f64,
                         p_out, p_off: i32): i32 {
    let off: i32 = p_off;
    let cap: i32 = p_out.length;
    let x0: f64 = p_x0; let y0: f64 = p_y0;
    let x1: f64 = p_x1; let y1: f64 = p_y1;

    let ax: f64 = p_in[0];  let ay: f64 = p_in[1];
    let bx: f64 = p_in[8];  let by: f64 = p_in[9];
    let cx: f64 = p_in[16]; let cy: f64 = p_in[17];

    if (ax >= x0 && ax <= x1 && ay >= y0 && ay <= y1 &&
        bx >= x0 && bx <= x1 && by >= y0 && by <= y1 &&
        cx >= x0 && cx <= x1 && cy >= y0 && cy <= y1) {
        if (off + 24 > cap) { let bad: i32 = -1; return bad; }
        for (let k = 0; k < 24; k++) { p_out[off + k] = p_in[k]; }
        let one: i32 = 1;
        return one;
    }

    for (let k1 = 0; k1 < 24; k1++) { g_clip_pa[k1] = p_in[k1]; }
    let n: i32 = 3;

    n = clip_half_flat(g_clip_pa, n, g_clip_pb, 0, x0, y0, x1, y1);
    if (n >= 3) { n = clip_half_flat(g_clip_pb, n, g_clip_pa, 1, x0, y0, x1, y1); }
    else {
        // mirror the legacy short-circuit: the survivor lives in pb
        let zero: i32 = 0;
        return zero;
    }
    if (n >= 3) { n = clip_half_flat(g_clip_pa, n, g_clip_pb, 2, x0, y0, x1, y1); }
    else { let zero1: i32 = 0; return zero1; }
    if (n >= 3) { n = clip_half_flat(g_clip_pb, n, g_clip_pa, 3, x0, y0, x1, y1); }
    else { let zero2: i32 = 0; return zero2; }

    let tris: i32 = 0;
    if (n >= 3) { tris = n - 2; }
    if (tris == 0) { let zero3: i32 = 0; return zero3; }
    if (off + tris * 24 > cap) { let bad2: i32 = -1; return bad2; }

    let w: i32 = off;
    for (let k2 = 2; k2 < n; k2++) {
        let s1: i32 = (k2 - 1) * 8;
        let s2: i32 = k2 * 8;
        for (let q = 0; q < 8; q++)  { p_out[w + q]      = g_clip_pa[q]; }
        for (let q1 = 0; q1 < 8; q1++) { p_out[w + 8 + q1]  = g_clip_pa[s1 + q1]; }
        for (let q2 = 0; q2 < 8; q2++) { p_out[w + 16 + q2] = g_clip_pa[s2 + q2]; }
        w = w + 24;
    }
    let out: i32 = tris;
    return out;
}

// ===========================================================================
// LEGACY OBJECT API — kept verbatim for scene_gpu.hml / bench_scale.hml.
// Allocates. Do not use in new code. See G7.
// ===========================================================================

fn ndist(v): f64 { return v.z + v.w; }   // > 0 = in front of the near plane

fn lerp_cv(a, b, t: f64) {
    return { x: a.x + (b.x - a.x) * t,
             y: a.y + (b.y - a.y) * t,
             z: a.z + (b.z - a.z) * t,
             w: a.w + (b.w - a.w) * t,
             u: a.u + (b.u - a.u) * t,
             v: a.v + (b.v - a.v) * t,
             l: a.l + (b.l - a.l) * t };
}

// Sutherland–Hodgman of triangle abc against the near plane. Returns an array
// of 0, 1 or 2 triangles (each an array of 3 clip vertices); winding is
// preserved.
export fn clip_tri_near(a, b, c) {
    let da = ndist(a); let db = ndist(b); let dc = ndist(c);
    if (da > g_CLIP_EPS && db > g_CLIP_EPS && dc > g_CLIP_EPS) { return [[a, b, c]]; }
    if (da <= g_CLIP_EPS && db <= g_CLIP_EPS && dc <= g_CLIP_EPS) { return []; }

    let vin = [a, b, c];
    let din = [da, db, dc];
    let out = [];
    for (let i = 0; i < 3; i++) {
        let j = (i + 1) % 3;
        let di = din[i]; let dj = din[j];
        if (di > g_CLIP_EPS) { out.push(vin[i]); }
        // edge crosses the plane: cut at d = EPS (toward the kept side)
        if ((di > g_CLIP_EPS && dj <= g_CLIP_EPS) || (di <= g_CLIP_EPS && dj > g_CLIP_EPS)) {
            out.push(lerp_cv(vin[i], vin[j], (di - g_CLIP_EPS) / (di - dj)));
        }
    }
    // 3 or 4 vertices survive; fan-triangulate
    let tris = [[out[0], out[1], out[2]]];
    if (out.length == 4) { tris.push([out[0], out[2], out[3]]); }
    return tris;
}

fn lerp_sv(a, b, t: f64) {
    return { x: a.x + (b.x - a.x) * t,
             y: a.y + (b.y - a.y) * t,
             z: a.z + (b.z - a.z) * t,
             u: a.u + (b.u - a.u) * t,
             v: a.v + (b.v - a.v) * t,
             r: i32(a.r + (b.r - a.r) * t),
             g: i32(a.g + (b.g - a.g) * t),
             b: i32(a.b + (b.b - a.b) * t) };
}

// Clip polygon `poly` against the half-plane dfn(v) >= 0.
fn clip_half(poly, dfn) {
    let out = [];
    let n = poly.length;
    for (let i = 0; i < n; i++) {
        let j = (i + 1) % n;
        let di = dfn(poly[i]); let dj = dfn(poly[j]);
        if (di >= 0.0) { out.push(poly[i]); }
        if ((di >= 0.0 && dj < 0.0) || (di < 0.0 && dj >= 0.0)) {
            out.push(lerp_sv(poly[i], poly[j], di / (di - dj)));
        }
    }
    return out;
}

// Clip screen-space triangle abc against rect [x0,x1]x[y0,y1]; returns an
// array of 0..5 triangles. Fully inside (the usual case) exits early.
export fn clip_tri_rect(a, b, c, x0: f64, y0: f64, x1: f64, y1: f64) {
    if (a.x >= x0 && a.x <= x1 && a.y >= y0 && a.y <= y1 &&
        b.x >= x0 && b.x <= x1 && b.y >= y0 && b.y <= y1 &&
        c.x >= x0 && c.x <= x1 && c.y >= y0 && c.y <= y1) {
        return [[a, b, c]];
    }
    let poly = [a, b, c];
    poly = clip_half(poly, fn(v) { return v.x - x0; });
    if (poly.length >= 3) { poly = clip_half(poly, fn(v) { return x1 - v.x; }); }
    if (poly.length >= 3) { poly = clip_half(poly, fn(v) { return v.y - y0; }); }
    if (poly.length >= 3) { poly = clip_half(poly, fn(v) { return y1 - v.y; }); }
    let tris = [];
    for (let k = 2; k < poly.length; k++) {
        tris.push([poly[0], poly[k - 1], poly[k]]);
    }
    return tris;
}
