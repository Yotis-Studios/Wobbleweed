// LEGACY — not on the shipping path. See ENGINE_GAPS.md.
// scene_gpu.hml — the demo world emitted as GPU triangles (SDL_RenderGeometry).
//
// Same world as scene.hml, but instead of filling pixels on the CPU we project
// vertices and queue triangles into a geom batch; the GPU rasterizes them with
// affine UVs (the wobble) and Gouraud vertex colors. Painter's sort in the batch
// handles occlusion (no z-buffer — like real PS1).
//
// Triangles are near-clipped in clip space before the perspective divide
// (shared clip.hml), so walking into geometry cuts it cleanly instead of
// popping whole quads.

import { floor } from "@stdlib/math";
import { v3, v_norm, v_dot, mat_apply, mat_apply_dir, mat_mul, mat_translate,
         mat_perspective, mat_look_at } from "./vec.hml";
import { batch_tri } from "./geom.hml";
import { clip_tri_near, clip_tri_rect } from "./clip.hml";
import { load_obj, palette } from "./obj.hml";

let SUN = v_norm(v3(0.4, 1.0, 0.55));
let AMBIENT = 0.45;

fn face_light(n): f64 {
    let d = v_dot(n, SUN);
    if (d < 0.0) { d = 0.0; }
    return AMBIENT + (1.0 - AMBIENT) * d;
}

export fn camera_mvp(eye, target, w: i32, h: i32) {
    let proj = mat_perspective(1.15, w / h, 0.1, 200.0);
    let view = mat_look_at(eye, target, v3(0.0, 1.0, 0.0));
    return mat_mul(proj, view);
}

// World-space point -> clip-space vertex carrying UV + light (no divide yet).
fn cv(mvp, p, u: f64, v: f64, l: f64) {
    let c = mat_apply(mvp, p);
    return { x: c.x, y: c.y, z: c.z, w: c.w, u: u, v: v, l: l };
}

// Perspective divide + viewport -> a geom vertex. The gray Gouraud color is
// light*255 (it modulates the texture). Only called after the near clip, so w
// is safely positive. Screen x/y snap to whole pixels like the PS1 (no
// subpixel precision = the vertex jitter), same as the CPU path.
fn to_screen(v, W: f64, H: f64) {
    let inv = 1.0 / v.w;
    let c = i32(v.l * 255.0);
    if (c > 255) { c = 255; } if (c < 0) { c = 0; }
    return { x: floor((v.x * inv * 0.5 + 0.5) * W + 0.5),
             y: floor((1.0 - (v.y * inv * 0.5 + 0.5)) * H + 0.5),
             z: v.z * inv, u: v.u, v: v.v, r: c, g: c, b: c };
}

// Near-clip a clip-space triangle, project, then guard-band clip the screen
// triangle (SDL's software rasterizer rejects triangles with huge off-screen
// extents) and queue whatever survives.
fn draw_tri(b, tex, va, vb, vc, W: f64, H: f64) {
    let m = 2.0 * W;   // guard margin: cuts land well off-screen
    let tris = clip_tri_near(va, vb, vc);
    for (t in tris) {
        let p0 = to_screen(t[0], W, H);
        let p1 = to_screen(t[1], W, H);
        let p2 = to_screen(t[2], W, H);
        let st = clip_tri_rect(p0, p1, p2, 0.0 - m, 0.0 - m, W + m, H + m);
        for (s in st) { batch_tri(b, tex, s[0], s[1], s[2]); }
    }
}

// full-white textured vertex (texture shown unmodulated), behind everything
fn skv(x: f64, y: f64, u: f64, v: f64) {
    return { x: x, y: y, z: 2.0, u: u, v: v, r: 255, g: 255, b: 255 };
}

fn emit_sky_quad(b, skytex, u0: f64, u1: f64, xa: f64, xb: f64, H: f64) {
    batch_tri(b, skytex, skv(xa, 0.0, u0, 0.0), skv(xb, 0.0, u1, 0.0), skv(xb, H, u1, 1.0));
    batch_tri(b, skytex, skv(xa, 0.0, u0, 0.0), skv(xb, H, u1, 1.0), skv(xa, H, u0, 1.0));
}

// The sky: a fullscreen quad sampling the panorama texture, panned by yaw so the
// clouds slide as you turn (z = 2.0, past the far plane -> painter draws it
// first). The visible window is hfov wide; when it crosses the texture's wrap
// seam we split into two quads so UVs always stay in [0,1] (no reliance on
// GPU/software texture-wrap behaviour, which differs between them).
let TWO_PI = 6.283185307;
let HFOV = 1.42;   // ~ horizontal field of view for fovy=1.15, 4:3

fn emit_sky(b, skytex, yaw: f64, W: f64, H: f64) {
    let uspan = HFOV / TWO_PI;
    let turns = yaw / TWO_PI;
    let uoff = turns - i64(turns);    // fractional turn
    if (uoff < 0.0) { uoff = uoff + 1.0; }
    let uend = uoff + uspan;
    if (uend <= 1.0) {
        emit_sky_quad(b, skytex, uoff, uend, 0.0, W, H);
    } else {
        let split = W * (1.0 - uoff) / uspan;
        emit_sky_quad(b, skytex, uoff, 1.0, 0.0, split, H);
        emit_sky_quad(b, skytex, 0.0, uend - 1.0, split, W, H);
    }
}

// --- OBJ meshes, lit per vertex (Gouraud) ---

// The demo tree + its colors, bundled so examples just pass it around.
export fn load_tree(path: string) {
    let mesh = load_obj(path);
    let colors = palette(mesh, { trunk:  { r: 112, g: 78, b: 46 },
                                 leaves: { r: 58, g: 138, b: 62 } },
                         { r: 160, g: 160, b: 160 });
    return { mesh: mesh, colors: colors };
}

// Solid-color Gouraud mesh: light each vertex from its smooth normal and bake
// color*light into the vertex color; the GPU interpolates (untextured tris,
// tex = null). Near-clip + guard band as usual — the gray from to_screen gets
// recolored per channel.
fn recolor(v, col) {
    return { x: v.x, y: v.y, z: v.z, u: 0.0, v: 0.0,
             r: i32(col.r * v.r / 255.0), g: i32(col.g * v.g / 255.0),
             b: i32(col.b * v.b / 255.0) };
}

export fn render_mesh_gpu(b, mvp, tree, model, W: f64, H: f64) {
    let mesh = tree.mesh; let colors = tree.colors;
    let mm = mat_mul(mvp, model);
    let m = 2.0 * W;
    for (f in mesh.faces) {
        let col = colors[f.m];
        let la = face_light(v_norm(mat_apply_dir(model, mesh.nrm[f.na])));
        let lb = face_light(v_norm(mat_apply_dir(model, mesh.nrm[f.nb])));
        let lc = face_light(v_norm(mat_apply_dir(model, mesh.nrm[f.nc])));
        let va = cv(mm, mesh.pos[f.pa], 0.0, 0.0, la);
        let vb = cv(mm, mesh.pos[f.pb], 0.0, 0.0, lb);
        let vc = cv(mm, mesh.pos[f.pc], 0.0, 0.0, lc);
        let tris = clip_tri_near(va, vb, vc);
        for (t in tris) {
            let p0 = recolor(to_screen(t[0], W, H), col);
            let p1 = recolor(to_screen(t[1], W, H), col);
            let p2 = recolor(to_screen(t[2], W, H), col);
            let st = clip_tri_rect(p0, p1, p2, 0.0 - m, 0.0 - m, W + m, H + m);
            for (s in st) { batch_tri(b, null, s[0], s[1], s[2]); }
        }
    }
}

// Textured quad p0..p3 (world space, UVs (0,0)(1,0)(1,1)(0,1)).
fn emit_quad(b, tex, mvp, p0, p1, p2, p3, light: f64, W: f64, H: f64) {
    let a = cv(mvp, p0, 0.0, 0.0, light);
    let bb = cv(mvp, p1, 1.0, 0.0, light);
    let c = cv(mvp, p2, 1.0, 1.0, light);
    let d = cv(mvp, p3, 0.0, 1.0, light);
    draw_tri(b, tex, a, bb, c, W, H);
    draw_tri(b, tex, a, c, d, W, H);
}

// Render the world into batch `b`. gtex/ctex are SDL textures (grass, crate);
// `tree` is a load_tree() bundle.
export fn render_world_gpu(b, mvp, yaw: f64, W: f64, H: f64, gtex, ctex, skytex, tree) {
    emit_sky(b, skytex, yaw, W, H);

    // ground grid
    let G = 26.0; let N = 16; let step = (2.0 * G) / N;
    let glight = face_light(v3(0.0, 1.0, 0.0));
    for (let i = 0; i < N; i++) {
        for (let j = 0; j < N; j++) {
            let x0 = 0.0 - G + i * step; let x1 = x0 + step;
            let z0 = 0.0 - G + j * step; let z1 = z0 + step;
            emit_quad(b, gtex, mvp, v3(x0, 0.0, z0), v3(x1, 0.0, z0),
                      v3(x1, 0.0, z1), v3(x0, 0.0, z1), glight, W, H);
        }
    }

    // crate: 4 sides + top
    let s = 1.6; let hgt = 2.6;
    let x0 = 0.0 - s; let x1 = s; let z0 = 0.0 - s; let z1 = s; let y0 = 0.0; let y1 = hgt;
    // +z, -z, +x, -x faces, then top
    emit_quad(b, ctex, mvp,
        v3(x0, y1, z1), v3(x1, y1, z1), v3(x1, y0, z1), v3(x0, y0, z1),
        face_light(v3(0.0, 0.0, 1.0)), W, H);
    emit_quad(b, ctex, mvp,
        v3(x1, y1, z0), v3(x0, y1, z0), v3(x0, y0, z0), v3(x1, y0, z0),
        face_light(v3(0.0, 0.0, 0.0 - 1.0)), W, H);
    emit_quad(b, ctex, mvp,
        v3(x1, y1, z1), v3(x1, y1, z0), v3(x1, y0, z0), v3(x1, y0, z1),
        face_light(v3(1.0, 0.0, 0.0)), W, H);
    emit_quad(b, ctex, mvp,
        v3(x0, y1, z0), v3(x0, y1, z1), v3(x0, y0, z1), v3(x0, y0, z0),
        face_light(v3(0.0 - 1.0, 0.0, 0.0)), W, H);
    emit_quad(b, ctex, mvp,
        v3(x0, y1, z0), v3(x1, y1, z0), v3(x1, y1, z1), v3(x0, y1, z1),
        face_light(v3(0.0, 1.0, 0.0)), W, H);

    // the tree: an OBJ mesh, Gouraud-lit from smooth normals
    render_mesh_gpu(b, mvp, tree, mat_translate(-5.0, 0.0, -3.0), W, H);
}
