// LEGACY — not on the shipping path. See ENGINE_GAPS.md.
// raster.hml — the triangle rasterizer (the retro core).
//
// Edge-function barycentric coverage with a z-buffer. Attribute interpolation
// (depth, and later UV/light) is *affine* — no perspective correction — which
// is exactly what gives PS1-era polygons their signature texture swim.
//
// Screen coordinates are in pixels (x right, y down). `z` is NDC depth in
// [-1,1]; smaller = nearer.

import { floor } from "@stdlib/math";

fn edge(ax: f64, ay: f64, bx: f64, by: f64, px: f64, py: f64): f64 {
    return (bx - ax) * (py - ay) - (by - ay) * (px - ax);
}
fn fmin(a: f64, b: f64): f64 { if (a < b) { return a; } return b; }
fn fmax(a: f64, b: f64): f64 { if (a > b) { return a; } return b; }
fn clampi(v: i32, lo: i32, hi: i32): i32 {
    if (v < lo) { return lo; } if (v > hi) { return hi; } return v;
}

// Flat-color triangle, z-tested.
export fn fill_tri(fb, ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64,
                   cx: f64, cy: f64, cz: f64, r: i32, g: i32, b: i32) {
    let w = fb.width; let h = fb.height;
    let area = edge(ax, ay, bx, by, cx, cy);
    if (area == 0.0) { return; }

    let minx = clampi(i32(floor(fmin(ax, fmin(bx, cx)))), 0, w - 1);
    let maxx = clampi(i32(floor(fmax(ax, fmax(bx, cx)))), 0, w - 1);
    let miny = clampi(i32(floor(fmin(ay, fmin(by, cy)))), 0, h - 1);
    let maxy = clampi(i32(floor(fmax(ay, fmax(by, cy)))), 0, h - 1);

    let inv = 1.0 / area;
    let pos = area > 0.0;
    let cr = r & 255; let cg = g & 255; let cb = b & 255;
    let color = fb.color; let depth = fb.depth;

    for (let y = miny; y <= maxy; y++) {
        for (let x = minx; x <= maxx; x++) {
            let px = x + 0.5; let py = y + 0.5;
            let w0 = edge(bx, by, cx, cy, px, py);
            let w1 = edge(cx, cy, ax, ay, px, py);
            let w2 = edge(ax, ay, bx, by, px, py);
            let inside = pos
                ? (w0 >= 0.0 && w1 >= 0.0 && w2 >= 0.0)
                : (w0 <= 0.0 && w1 <= 0.0 && w2 <= 0.0);
            if (inside) {
                let b0 = w0 * inv; let b1 = w1 * inv; let b2 = w2 * inv;
                let z = b0 * az + b1 * bz + b2 * cz;
                let idx = y * w + x;
                if (z < depth[idx]) {
                    depth[idx] = z;
                    let o = idx * 3;
                    color[o] = cr; color[o + 1] = cg; color[o + 2] = cb;
                }
            }
        }
    }
}

// Gouraud triangle: flat base color scaled by per-vertex light, z-tested.
// Light interpolates affinely like everything else here; it's clamped to
// [0,1] so sliver triangles can't extrapolate the color out of range.
export fn fill_tri_shade(fb, ax: f64, ay: f64, az: f64, la: f64,
                         bx: f64, by: f64, bz: f64, lb: f64,
                         cx: f64, cy: f64, cz: f64, lc: f64,
                         r: i32, g: i32, b: i32) {
    let w = fb.width; let h = fb.height;
    let area = edge(ax, ay, bx, by, cx, cy);
    if (area == 0.0) { return; }

    let minx = clampi(i32(floor(fmin(ax, fmin(bx, cx)))), 0, w - 1);
    let maxx = clampi(i32(floor(fmax(ax, fmax(bx, cx)))), 0, w - 1);
    let miny = clampi(i32(floor(fmin(ay, fmin(by, cy)))), 0, h - 1);
    let maxy = clampi(i32(floor(fmax(ay, fmax(by, cy)))), 0, h - 1);

    let inv = 1.0 / area;
    let pos = area > 0.0;
    let color = fb.color; let depth = fb.depth;

    for (let y = miny; y <= maxy; y++) {
        for (let x = minx; x <= maxx; x++) {
            let px = x + 0.5; let py = y + 0.5;
            let w0 = edge(bx, by, cx, cy, px, py);
            let w1 = edge(cx, cy, ax, ay, px, py);
            let w2 = edge(ax, ay, bx, by, px, py);
            let inside = pos
                ? (w0 >= 0.0 && w1 >= 0.0 && w2 >= 0.0)
                : (w0 <= 0.0 && w1 <= 0.0 && w2 <= 0.0);
            if (inside) {
                let b0 = w0 * inv; let b1 = w1 * inv; let b2 = w2 * inv;
                let z = b0 * az + b1 * bz + b2 * cz;
                let idx = y * w + x;
                if (z < depth[idx]) {
                    let light = b0 * la + b1 * lb + b2 * lc;
                    if (light < 0.0) { light = 0.0; }
                    if (light > 1.0) { light = 1.0; }
                    depth[idx] = z;
                    let o = idx * 3;
                    color[o]     = i32(r * light) & 255;
                    color[o + 1] = i32(g * light) & 255;
                    color[o + 2] = i32(b * light) & 255;
                }
            }
        }
    }
}

// Affine textured triangle with per-vertex light scaling. UVs in [0,1].
// `tex` is { width, height, data(buffer w*h*3) }; sampled nearest-neighbour.
export fn fill_tri_tex(fb, ax: f64, ay: f64, az: f64, ua: f64, va: f64, la: f64,
                       bx: f64, by: f64, bz: f64, ub: f64, vb: f64, lb: f64,
                       cx: f64, cy: f64, cz: f64, uc: f64, vc: f64, lc: f64, tex) {
    let w = fb.width; let h = fb.height;
    let area = edge(ax, ay, bx, by, cx, cy);
    if (area == 0.0) { return; }

    let minx = clampi(i32(floor(fmin(ax, fmin(bx, cx)))), 0, w - 1);
    let maxx = clampi(i32(floor(fmax(ax, fmax(bx, cx)))), 0, w - 1);
    let miny = clampi(i32(floor(fmin(ay, fmin(by, cy)))), 0, h - 1);
    let maxy = clampi(i32(floor(fmax(ay, fmax(by, cy)))), 0, h - 1);

    let inv = 1.0 / area;
    let pos = area > 0.0;
    let tw = tex.width; let th = tex.height; let td = tex.data;
    let color = fb.color; let depth = fb.depth;

    for (let y = miny; y <= maxy; y++) {
        for (let x = minx; x <= maxx; x++) {
            let px = x + 0.5; let py = y + 0.5;
            let w0 = edge(bx, by, cx, cy, px, py);
            let w1 = edge(cx, cy, ax, ay, px, py);
            let w2 = edge(ax, ay, bx, by, px, py);
            let inside = pos
                ? (w0 >= 0.0 && w1 >= 0.0 && w2 >= 0.0)
                : (w0 <= 0.0 && w1 <= 0.0 && w2 <= 0.0);
            if (inside) {
                let b0 = w0 * inv; let b1 = w1 * inv; let b2 = w2 * inv;
                let z = b0 * az + b1 * bz + b2 * cz;
                let idx = y * w + x;
                if (z < depth[idx]) {
                    // affine UV + light
                    let u = b0 * ua + b1 * ub + b2 * uc;
                    let v = b0 * va + b1 * vb + b2 * vc;
                    let light = b0 * la + b1 * lb + b2 * lc;
                    let tx = i32(u * tw) % tw; if (tx < 0) { tx = tx + tw; }
                    let ty = i32(v * th) % th; if (ty < 0) { ty = ty + th; }
                    let to = (ty * tw + tx) * 3;
                    depth[idx] = z;
                    let o = idx * 3;
                    color[o]     = i32(td[to] * light) & 255;
                    color[o + 1] = i32(td[to + 1] * light) & 255;
                    color[o + 2] = i32(td[to + 2] * light) & 255;
                }
            }
        }
    }
}
