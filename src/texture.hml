// texture.hml — textures for the rasterizer.
//
// A texture is { width, height, data } where data is a width*height*3 RGB
// buffer. Sampling is nearest-neighbour (chunky, on purpose). Includes a couple
// of procedural generators so the engine is self-contained.

export fn tex_new(w: i32, h: i32): object {
    return { width: w, height: h, data: buffer(w * h * 3) };
}

// Deterministic per-texel hash -> 0..255. Done in i64 with 32-bit masking so
// the big-prime multiplies don't overflow.
fn hash2(x: i32, y: i32): i32 {
    let mask: i64 = 4294967295;
    let n: i64 = (i64(x) * 374761393 + i64(y) * 668265263) & mask;
    n = ((n ^ (n >> 13)) * 1274126177) & mask;
    n = n ^ (n >> 16);
    return i32(n & 255);
}

// Procedural grass: noisy greens with a few darker blades. Tiles seamlessly-ish.
export fn tex_grass(w: i32, h: i32): object {
    let t = tex_new(w, h);
    let d = t.data;
    for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
            let n = hash2(x, y);
            let n2 = hash2(x * 3 + 7, y * 3 + 11);
            let g = 90 + (n % 70);          // green base + variation
            let r = 35 + (n2 % 35);
            let b = 30 + (n % 25);
            if (n2 < 24) { g = g - 35; r = r - 10; }   // darker clumps
            let o = (y * w + x) * 3;
            d[o] = r & 255; d[o + 1] = g & 255; d[o + 2] = b & 255;
        }
    }
    return t;
}

fn fabs(x: f64): f64 { if (x < 0.0) { return 0.0 - x; } return x; }

// Sky panorama: a vertical gradient plus chunky, pixelated cloud streaks,
// tileable horizontally so the GPU sky quad can pan seamlessly with camera yaw.
// V (0..1) runs deep-blue overhead -> pale at the horizon.
export fn tex_sky(w: i32, h: i32): object {
    let t = tex_new(w, h);
    let d = t.data;
    let CH = 8;                  // cloud block size (chunky)
    let cellsx = w / CH;         // horizontal period -> seamless wrap
    for (let y = 0; y < h; y++) {
        let ty = y / (h - 1);
        let br = i32(60.0 + (150.0 - 60.0) * ty);
        let bg = i32(100.0 + (186.0 - 100.0) * ty);
        let bb = i32(196.0 + (226.0 - 196.0) * ty);
        let band = 1.0 - fabs(ty - 0.34) * 1.7;   // clouds peak in the upper-mid sky
        if (band < 0.0) { band = 0.0; }
        let cy = i32(y / (CH * 2));                // stretch vertically -> streaks
        for (let x = 0; x < w; x++) {
            let r = br; let g = bg; let b = bb;
            if (band > 0.0) {
                let cx = i32(x / CH) % cellsx;
                let cx2 = (cx + 17) % cellsx;
                let n = (hash2(cx, cy) + hash2(cx2, cy * 2 + 3)) / 2;
                let cloud = (n / 255.0) * band;
                if (cloud > 0.46) {
                    let amt = (cloud - 0.46) / 0.54;
                    if (amt > 1.0) { amt = 1.0; }
                    r = i32(r + (246.0 - r) * amt);
                    g = i32(g + (249.0 - g) * amt);
                    b = i32(b + (255.0 - b) * amt);
                }
            }
            let o = (y * w + x) * 3;
            d[o] = r & 255; d[o + 1] = g & 255; d[o + 2] = b & 255;
        }
    }
    return t;
}

// Checkerboard — handy for *seeing* the affine texture warp clearly.
export fn tex_checker(w: i32, h: i32, cells: i32): object {
    let t = tex_new(w, h);
    let d = t.data;
    let cs = w / cells;
    for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
            let on = ((i32(x / cs) + i32(y / cs)) % 2) == 0;
            let o = (y * w + x) * 3;
            let v = on ? 210 : 70;
            d[o] = v & 255; d[o + 1] = v & 255; d[o + 2] = v & 255;
        }
    }
    return t;
}
