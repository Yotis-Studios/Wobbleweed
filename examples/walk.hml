// walk.hml — a real-time, walkable retro scene in an SDL window.
//
//   WASD  move        arrows  look        Space  toggle dither        Esc  quit
//
// Renders the same world as scene_png.hml into the framebuffer every frame and
// presents it through SDL. Compile for smooth real-time:
//   hemlockc examples/walk.hml -o walk && ./walk
// (The interpreter works too, just slowly — it's a software rasterizer.)

import { sin, cos } from "@stdlib/math";
import { v3, v_add, v_scale } from "../src/vec.hml";
import { fb_new } from "../src/framebuffer.hml";
import { camera_mvp, render_world, load_tree } from "../src/scene.hml";
import { fb_retro } from "../src/postfx.hml";
import { tex_grass, tex_checker } from "../src/texture.hml";
import { window_open, present, poll, keystate, held, ticks, delay, window_close,
         KEY_SPACE,
         SC_W, SC_A, SC_S, SC_D, SC_LEFT, SC_RIGHT, SC_UP, SC_DOWN } from "../src/sdl.hml";

let W = 320; let H = 240;

fn main() {
    let win = window_open("Wobbleweed", W, H, 3);
    if (win == null) { eprint("could not open window"); return; }

    let fb = fb_new(W, H);
    let grass = tex_grass(32, 32);
    let crate = tex_checker(32, 32, 4);
    let tree = load_tree("assets/tree.obj");

    // camera state
    let pos = v3(4.0, 2.0, 10.0);
    let yaw = 0.0 - 0.35;     // radians, 0 looks toward -Z
    let pitch = 0.0 - 0.08;

    let move_speed = 0.18;
    let turn_speed = 0.045;
    let retro = true;     // Space toggles the 5-bit dither pass

    let running = true;
    let frame = 0;
    let t0 = ticks();

    while (running) {
        let ev = poll(win);
        if (ev.quit) { running = false; }
        for (k in ev.keys) {
            if (k == KEY_SPACE) { retro = !retro; }
        }
        let ks = keystate();

        // look
        if (held(ks, SC_LEFT))  { yaw = yaw - turn_speed; }
        if (held(ks, SC_RIGHT)) { yaw = yaw + turn_speed; }
        if (held(ks, SC_UP))    { pitch = pitch + turn_speed; }
        if (held(ks, SC_DOWN))  { pitch = pitch - turn_speed; }
        if (pitch > 1.4) { pitch = 1.4; }
        if (pitch < 0.0 - 1.4) { pitch = 0.0 - 1.4; }

        // movement on the ground plane (yaw only)
        let fwd = v3(sin(yaw), 0.0, 0.0 - cos(yaw));
        let rgt = v3(cos(yaw), 0.0, sin(yaw));
        if (held(ks, SC_W)) { pos = v_add(pos, v_scale(fwd, move_speed)); }
        if (held(ks, SC_S)) { pos = v_add(pos, v_scale(fwd, 0.0 - move_speed)); }
        if (held(ks, SC_D)) { pos = v_add(pos, v_scale(rgt, move_speed)); }
        if (held(ks, SC_A)) { pos = v_add(pos, v_scale(rgt, 0.0 - move_speed)); }

        // full look direction (with pitch) for the view target
        let look = v3(sin(yaw) * cos(pitch), sin(pitch), (0.0 - cos(yaw)) * cos(pitch));
        let target = v_add(pos, look);

        let mvp = camera_mvp(pos, target, W, H);
        render_world(fb, mvp, yaw, pitch, grass, crate, tree);
        if (retro) { fb_retro(fb); }
        present(win, buffer_ptr(fb.color));

        frame = frame + 1;
        if (frame % 60 == 0) {
            let secs = (ticks() - t0) / 1000.0;
            eprint(`frame ${frame}  ~${i32(frame / secs)} fps`);
        }
        delay(4);
    }

    window_close(win);
    print("bye");
}

main();
