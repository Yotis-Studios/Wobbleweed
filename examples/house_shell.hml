let S_SIDING = 0;    let S_BRICK = 1;   let S_SHINGLE = 2;  let S_WHITE = 3;
let S_CONC = 4;      let S_GRASS = 5;   let S_WINU = 6;     let S_WINP = 7;
let S_DOOR = 8;      let S_GDOOR = 9;   let S_LANT = 10;    let S_WINL = 11;
