// house_shell.hml — THE BUILDING, as a module.
//
// Split out of examples/house.hml by the critic pass so the house can stand in
// the real yard (examples/house_world.hml) instead of on a placeholder plane.
// examples/house.hml is now the thin four-angle runner over this module and
// examples/house_scene.hml is the integrated demo. NOTHING IN HERE CHANGED
// MEANING in the split: the constants, the atlas and every builder are the
// house half's, verbatim. Only the entry points at the bottom are new.
//
// Exports, in the order you call them:
//     hs_build_assets()   -> builds the 128x128 house atlas and the sky strip
//     hs_atlas() / hs_sky_atlas()
//     hs_build()          -> the two meshes: mass and applied trim
//     hs_mesh_house() / hs_mesh_trim() / hs_tris()
//     hs_build_ground()   -> the PLACEHOLDER lawn (house.hml only; the scene
//                            uses house_world.hml's)
//     HS_TRIM_BIAS        -> subtract this from the trim mesh's painter keys
//
// The trim mesh must be emitted with its depth keys pulled HS_TRIM_BIAS toward
// the camera or every applied detail sinks into the wall it is lying on. There
// is no polygon offset in this engine; see the note in examples/house.hml.

import { divi } from "@stdlib/math";
import { atlas_new, atlas_px, atlas_rect_uv } from "../src/atlas.hml";
import { mesh_new, mesh_begin, mesh_vert, mesh_quad, mesh_end,
         mesh_tri_count, mesh_buf } from "../src/mesh.hml";
export let TW = 320;
export let TH = 240;
export let SCALE = 3;

export let FOVY = 1.0123;                  // 58 degrees
export let ASPECT = 1.3333333333333333;
export let NEARZ = 0.06;
export let FARZ = 260.0;
// The guard band has to be BIG for a ground plane.  emit.hml rejects any
// triangle that STRADDLES the guard rect (it wants clip.hml's slow path for
// those), and a lawn quad four metres from the eye projects thousands of
// pixels outside a 320x240 frame — so at the stock 640 px guard the quads
// nearest the camera were dropped and the sky showed through the grass in the
// bottom corner of the frame.  6000 px costs nothing here because SDL clips
// what it is handed.
export let GUARD = 6000.0;
export let DEPTH_FAR = 90.0;               // painter-sort range: 44 mm per bucket

export let SKY_W = 640;                    // twice the target width: the sky pans
export let SKY_H = 240;
export let ATL = 128;                      // the one house/ground atlas, 128 x 128

export let CAP_WORLD = 6000;
export let CAP_SKY = 8;

