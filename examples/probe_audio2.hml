// probe_audio2.hml — the acceptance probe for src/audio.hml (W1-7 / G18).
//
// It proves, with numbers rather than adjectives:
//   * init failure is reported and NON-FATAL (forced with a bogus SDL audio
//     driver, so it is reproducible on a box that has a working sound card);
//   * the PCM registry is PROVABLY ALIVE after the caller drops its handle —
//     registration happens inside a function whose local goes out of scope, the
//     probe then churns 32 MB of allocations, and only then plays the sound and
//     reads its bytes back through the registry;
//   * 8 simultaneous voices with 8 DISTINCT pans play with no dropout, verified
//     byte-exactly by capturing SDL's own mixed output through the `disk` audio
//     driver and scanning it for interior silence;
//   * panning is real (hard left => right channel is exactly 0, and vice versa)
//     and is a documented NO-OP on a mono device;
//   * per-frame Hemlock cost of a realistic playback load, in milliseconds;
//   * RSS is flat over a soak.
//
// Run it compiled, headless and on the real display:
//   HC=/home/nbeerbower/Projects/hemlock/hemlockc
//   $HC -O1 examples/probe_audio2.hml -o /tmp/probe_audio2
//   SDL_VIDEODRIVER=dummy /tmp/probe_audio2
//   DISPLAY=:0 /tmp/probe_audio2
//   /tmp/probe_audio2 --soak 600        # the 10-minute RSS soak
//
// Exit code is the contract: 0 iff every assertion passed AND the assertion
// count is exactly what it should be.

import { exit, get_pid } from "@stdlib/process";
import { setenv, unsetenv, getenv } from "@stdlib/env";
import { remove_file, exists } from "@stdlib/fs";
import { clock_now, clock_ms_between, clock_sleep_ms } from "../src/time.hml";
import { audio_init, audio_shutdown, audio_ready, audio_error,
         audio_out_freq, audio_out_format, audio_out_channels,
         audio_voice_capacity, audio_can_pan, audio_version_string,
         audio_register_pcm, audio_register_pcm_mono,
         audio_sound_count, audio_sound_bytes, audio_sound_ready,
         audio_sound_byte, audio_registry_bytes,
         audio_play, audio_play_panned, audio_play_looped,
         audio_stop_voice, audio_stop_all,
         audio_set_volume, audio_get_volume, audio_set_sound_volume,
         audio_voices_active, audio_voice_sound,
         audio_plays_total, audio_drops_total, audio_steals_total,
         audio_reset_counters, audio_report_string,
         AUDIO_FMT_S16, AUDIO_DEFAULT_FREQ,
         AUDIO_DEFAULT_CHUNK, AUDIO_DEFAULT_VOICES,
         AUDIO_LOOP_FOREVER } from "../src/audio.hml";

// ---------------------------------------------------------------------------
// Two FFI libraries, each with its own `import` immediately above its own
// externs — extern binds to the MOST RECENTLY DECLARED import, not to all of
// them. Both belong to the harness, not to the engine.
// ---------------------------------------------------------------------------

// MEASURED, AND REPORTED AS AN sdl.hml GAP (W1-7 report):
// Mix_CloseAudio does NOT release the SDL audio subsystem. After it,
// SDL_WasInit(SDL_INIT_AUDIO) is still non-zero and SDL_GetCurrentAudioDriver()
// still names the old driver, so the NEXT Mix_OpenAudio reuses the cached
// driver and ignores SDL_AUDIODRIVER. Only an explicit
// SDL_QuitSubSystem(SDL_INIT_AUDIO) clears it. This probe needs to switch
// drivers mid-run to capture the mixer's own output, so it binds the symbol
// itself. src/sdl.hml should export `sdl_quit_subsystem` / `sdl_was_init`;
// audio.hml does not bind SDL directly by design (sdl.hml is the OS surface).
import "libSDL2-2.0.so.0";
extern fn SDL_QuitSubSystem(flags: u32): void;
extern fn SDL_WasInit(flags: u32): u32;
extern fn SDL_GetCurrentAudioDriver(): string;

// libc, for reading the captured audio back as BINARY. @stdlib/fs read_file
// returns a string and truncates at the first NUL byte, which is useless for
// PCM. (fopen/fread/fclose rather than open/read/close: `open` collides with
// the Hemlock builtin of the same name, which returns a `file`.)
import "libc.so.6";
extern fn fopen(path: string, mode: string): ptr;
extern fn fread(buf: ptr, size: i64, nmemb: i64, stream: ptr): i64;
extern fn fclose(stream: ptr): i32;

let SDL_INIT_AUDIO_FLAG = 16;

let g_n = 0;
let g_pass = 0;
let g_notes = [];

// The probe asserts its own denominator as well as its numerator: a skipped
// branch that shrinks both would otherwise still print a green PASS n/n.
// --soak adds exactly 2 assertions.
let BASE_ASSERTIONS = 104;
let SOAK_ASSERTIONS = 2;

fn ok(name: string, cond: bool) {
    g_n = g_n + 1;
    if (cond) { g_pass = g_pass + 1; }
    else { print(`  FAIL #${g_n}  ${name}`); }
}

fn eq(name: string, got, want) {
    g_n = g_n + 1;
    if (got == want) { g_pass = g_pass + 1; }
    else { print(`  FAIL #${g_n}  ${name}: got ${got}, want ${want}`); }
}

fn note(s: string) { g_notes.push(s); }

// ===========================================================================
// helpers
// ===========================================================================

// Resident set size in KB, from /proc/self/statm field 2 (resident pages).
// Read through libc: @stdlib/fs read_file returns 0 bytes for a procfs file
// because procfs reports st_size == 0 and read_file trusts it.
let g_statm = buffer(256);
fn rss_kb(): i32 {
    let fh = fopen("/proc/self/statm", "rb");
    if (fh == ptr_null()) { let z: i32 = 0; return z; }
    let p = buffer_ptr(g_statm);
    let got: i64 = fread(p, 1, 255, fh);
    fclose(fh);
    let n: i32 = i32(got);
    if (n < 3) { let z2: i32 = 0; return z2; }
    // skip field 1, then read field 2
    let i: i32 = 0;
    while (i < n && ptr_deref_u8(ptr_offset(p, i, 1)) != 32) { i++; }
    while (i < n && ptr_deref_u8(ptr_offset(p, i, 1)) == 32) { i++; }
    let acc: i32 = 0;
    while (i < n) {
        let c: i32 = ptr_deref_u8(ptr_offset(p, i, 1));
        if (c < 48 || c > 57) { i = n; }
        else { acc = acc * 10 + (c - 48); i++; }
    }
    let out: i32 = acc * 4;      // 4 KB pages
    return out;
}

// A constant-amplitude S16 mono tone-block. Constant amplitude on purpose: a
// zero sample in the captured mix is then unambiguously a DROPOUT.
fn make_pcm(p_nsamp: i32, p_amp: i32) {
    let n: i32 = p_nsamp;
    let b = buffer(n * 2);
    let p = buffer_ptr(b);
    let a: i32 = p_amp;
    let i: i32 = 0;
    while (i < n) {
        // square wave at n/64 periods: every sample is +/-a, never 0.
        let s: i32 = a;
        if ((i / 32) % 2 == 1) { s = 0 - a; }
        ptr_write_i16(ptr_offset(p, i * 2, 1), s);
        i++;
    }
    return b;
}

// THE OWNERSHIP TEST. The buffer is created here, handed to the registry here,
// and this function's local — the caller's only handle — dies on return. If
// audio.hml did not retain it, the bytes the mixer reads are freed memory.
fn register_and_drop(p_nsamp: i32, p_amp: i32): i32 {
    let b = make_pcm(p_nsamp, p_amp);
    let id: i32 = audio_register_pcm_mono(b, p_nsamp * 2);
    let out: i32 = id;
    return out;
}

// Same, through the zero-copy device-format entry point.
fn register_raw_and_drop(p_nsamp: i32, p_amp: i32): i32 {
    let b = make_pcm(p_nsamp, p_amp);
    let id: i32 = audio_register_pcm(b, p_nsamp * 2);
    let out: i32 = id;
    return out;
}

// Allocate and touch p_mb megabytes, then let it all go. Anything the registry
// failed to retain has an excellent chance of being reused by this.
fn churn(p_mb: i32) {
    let n: i32 = p_mb * 16;
    let i: i32 = 0;
    while (i < n) {
        let t = buffer(65536);
        let p = buffer_ptr(t);
        let j: i32 = 0;
        while (j < 65536) { ptr_write_u8(ptr_offset(p, j, 1), 219); j = j + 512; }
        i++;
    }
}

// ---- captured-audio analysis ----------------------------------------------
let g_cap = buffer(1);
let g_cap_len = 0;

fn capture_read(p_path: string): i32 {
    g_cap_len = 0;
    let fh = fopen(p_path, "rb");
    if (fh == ptr_null()) { let z: i32 = 0; return z; }
    let cap: i32 = 8 * 1024 * 1024;
    let b = buffer(cap);
    let got: i64 = fread(buffer_ptr(b), 1, cap, fh);
    fclose(fh);
    if (got < 0) { let z2: i32 = 0; return z2; }
    g_cap = b;
    g_cap_len = i32(got);
    let out: i32 = g_cap_len;
    return out;
}

// Sum of |sample| for one channel of the captured interleaved S16 stereo.
fn cap_energy(p_chan: i32): i64 {
    let frames: i32 = g_cap_len / 4;
    let p = buffer_ptr(g_cap);
    let c: i32 = p_chan;
    let acc: i64 = 0;
    let i: i32 = 0;
    while (i < frames) {
        let v: i32 = ptr_deref_i16(ptr_offset(p, i * 4 + c * 2, 1));
        if (v < 0) { v = 0 - v; }
        acc = acc + v;
        i++;
    }
    let out: i64 = acc;
    return out;
}

// The LONGEST RUN of frames that are silent in BOTH channels, strictly between
// the first and the last frame that carries signal. That is the dropout
// measure: a real underrun is at least one device period (512 frames, 23 ms at
// 22050), so anything under a handful of frames is arithmetic cancellation
// between simultaneous voices, not a gap in the stream. Returns -1 when the
// capture carries no signal at all.
let g_gap_total = 0;
fn cap_gap_run(): i32 {
    g_gap_total = 0;
    let frames: i32 = g_cap_len / 4;
    let p = buffer_ptr(g_cap);
    let first: i32 = 0 - 1;
    let last: i32 = 0 - 1;
    let i: i32 = 0;
    while (i < frames) {
        let l: i32 = ptr_deref_i16(ptr_offset(p, i * 4, 1));
        let r: i32 = ptr_deref_i16(ptr_offset(p, i * 4 + 2, 1));
        if (l != 0 || r != 0) {
            if (first < 0) { first = i; }
            last = i;
        }
        i++;
    }
    if (first < 0) { let none: i32 = 0 - 1; return none; }
    let run: i32 = 0;
    let best: i32 = 0;
    i = first;
    while (i <= last) {
        let l2: i32 = ptr_deref_i16(ptr_offset(p, i * 4, 1));
        let r2: i32 = ptr_deref_i16(ptr_offset(p, i * 4 + 2, 1));
        if (l2 == 0 && r2 == 0) {
            run = run + 1;
            g_gap_total = g_gap_total + 1;
            if (run > best) { best = run; }
        } else { run = 0; }
        i++;
    }
    let out: i32 = best;
    return out;
}

// Drop the SDL audio subsystem so the next open re-reads SDL_AUDIODRIVER.
// See the note on the SDL externs above.
fn audio_hard_reset() {
    audio_shutdown();
    SDL_QuitSubSystem(SDL_INIT_AUDIO_FLAG);
}

// Open a device, falling back to SDL's dummy audio driver so the probe is
// deterministic on a box with no sound card. One assertion either way.
fn ensure_device(p_outch: i32, p_voices: i32): i32 {
    let r: i32 = audio_init(AUDIO_DEFAULT_FREQ, AUDIO_FMT_S16, p_outch,
                            AUDIO_DEFAULT_CHUNK, p_voices);
    if (r == 0) {
        note(`default audio driver failed (${audio_error()}); falling back to dummy`);
        setenv("SDL_AUDIODRIVER", "dummy");
        r = audio_init(AUDIO_DEFAULT_FREQ, AUDIO_FMT_S16, p_outch,
                       AUDIO_DEFAULT_CHUNK, p_voices);
    }
    let out: i32 = r;
    return out;
}

// ===========================================================================

fn main() {
    print("=== probe_audio2 — src/audio.hml (W1-7 / G18) ===");
    print(`SDL_mixer ${audio_version_string()}`);

    let argv = args;
    let soak_s: i32 = 0;
    let ai: i32 = 0;
    while (ai < argv.length) {
        if (argv[ai] == "--soak" && ai + 1 < argv.length) { soak_s = i32(argv[ai + 1]); }
        ai++;
    }

    // Valgrind slows execution ~60x and grows RSS with its own shadow memory,
    // so the two BUDGET assertions get a scaled ceiling under it. The assertion
    // COUNT is identical either way — only the number being compared changes.
    let under_vg: i32 = 0;
    let ldp = getenv("LD_PRELOAD");
    if (ldp != null) { if (ldp.contains("vgpreload")) { under_vg = 1; } }
    let ms_limit: f64 = 0.2;
    let rss_limit: i32 = 4096;
    if (under_vg == 1) {
        ms_limit = 20.0;
        rss_limit = 262144;
        note("running under valgrind: the ms/frame and RSS ceilings are scaled");
    }

    let pid: i32 = get_pid();
    let cap1: string = `/tmp/wobbleweed_audio2_${pid}_a.raw`;
    let cap2: string = `/tmp/wobbleweed_audio2_${pid}_b.raw`;
    let cap3: string = `/tmp/wobbleweed_audio2_${pid}_c.raw`;

    // =======================================================================
    print("");
    print("--- A. cold state: every entry point is safe before audio_init ---");
    // =======================================================================
    eq("audio_ready() is 0 before init", audio_ready(), 0);
    eq("audio_voices_active() is 0 before init", audio_voices_active(), 0);
    eq("audio_voice_capacity() is 0 before init", audio_voice_capacity(), 0);
    eq("audio_can_pan() is 0 before init", audio_can_pan(), 0);
    eq("audio_play on an unopened device drops, returns -1", audio_play(0, 1.0), 0 - 1);
    eq("the drop was counted", audio_drops_total(), 1);
    audio_stop_all();
    ok("audio_stop_all() before init is a no-op, not a crash", true);
    eq("audio_sound_count() is 0", audio_sound_count(), 0);
    eq("audio_sound_ready(0) is 0", audio_sound_ready(0), 0);
    eq("audio_sound_byte on an unknown id is -1", audio_sound_byte(0, 0), 0 - 1);
    eq("audio_registry_bytes() is 0", audio_registry_bytes(), 0);

    // Registration works with NO DEVICE — the game's synth pass must not have
    // to branch on whether the sound card exists.
    let early_id: i32 = register_and_drop(1024, 4000);
    eq("audio_register_pcm_mono with no device returns id 0", early_id, 0);
    eq("audio_sound_count() is 1", audio_sound_count(), 1);
    eq("that sound has no chunk yet", audio_sound_ready(early_id), 0);
    eq("but its bytes are already owned", audio_sound_bytes(early_id), 2048);
    eq("audio_register_pcm rejects a non-positive length", audio_register_pcm(g_cap, 0), 0 - 1);

    // =======================================================================
    print("");
    print("--- B. init failure is reported and NON-FATAL ---");
    // =======================================================================
    setenv("SDL_AUDIODRIVER", "wobbleweed_no_such_driver");
    let bad: i32 = audio_init(AUDIO_DEFAULT_FREQ, AUDIO_FMT_S16, 1,
                              AUDIO_DEFAULT_CHUNK, AUDIO_DEFAULT_VOICES);
    eq("audio_init returns 0 with an unusable audio driver", bad, 0);
    eq("audio_ready() is still 0", audio_ready(), 0);
    ok("audio_error() explains why", audio_error().length > 0);
    note(`forced init failure: ${audio_error()}`);
    eq("playing after a failed init drops and returns -1", audio_play(early_id, 1.0), 0 - 1);
    audio_shutdown();
    ok("audio_shutdown() after a failed init is safe", true);
    unsetenv("SDL_AUDIODRIVER");

    // =======================================================================
    print("");
    print("--- C. real device, the G18 configuration (22050 / S16 / mono) ---");
    // =======================================================================
    let r1: i32 = ensure_device(1, AUDIO_DEFAULT_VOICES);
    eq("audio_init opened a device", r1, 1);
    eq("audio_ready() is 1", audio_ready(), 1);
    eq("audio_error() is empty on success", audio_error(), "");
    eq("obtained rate is 22050", audio_out_freq(), 22050);
    eq("obtained format is S16LSB", audio_out_format(), AUDIO_FMT_S16);
    eq("obtained channel count is 1", audio_out_channels(), 1);
    eq("16 voices were allocated", audio_voice_capacity(), 16);
    // SDL_mixer 2.0.4 Mix_SetPanning is a documented no-op below 2 channels.
    eq("audio_can_pan() reports 0 on a mono device", audio_can_pan(), 0);
    eq("the sound registered before init now has a chunk", audio_sound_ready(early_id), 1);
    note(`mono device driver = ${SDL_GetCurrentAudioDriver()}`);
    note(`mono device: ${audio_report_string()}`);

    // ---- ownership -------------------------------------------------------
    print("");
    print("--- D. the registry outlives the caller's handle ---");
    let nsamp: i32 = 22050 / 4;             // 250 ms at 22050
    let sid: i32 = register_and_drop(nsamp, 3000);
    ok("registered a sound whose caller handle is already gone", sid >= 0);
    churn(32);                               // 32 MB through the allocator
    eq("its chunk is still live after 32 MB of allocation churn",
       audio_sound_ready(sid), 1);
    // Byte 0 of a +3000 S16LE sample is 0xB8, byte 1 is 0x0B.
    eq("registry byte 0 survives (0xB8)", audio_sound_byte(sid, 0), 184);
    eq("registry byte 1 survives (0x0B)", audio_sound_byte(sid, 1), 11);
    eq("registry last byte survives", audio_sound_byte(sid, nsamp * 2 - 1), 11);
    eq("out-of-range offset is rejected", audio_sound_byte(sid, nsamp * 2), 0 - 1);
    let ch0: i32 = audio_play(sid, 1.0);
    ok("playing the dropped-handle sound returns a voice", ch0 >= 0);
    eq("audio_voice_sound reports which sound is on that voice",
       audio_voice_sound(ch0), sid);
    clock_sleep_ms(30);
    ok("still alive 30 ms into playback", audio_sound_byte(sid, 2) == 184);
    audio_stop_all();
    eq("audio_stop_all silences every voice", audio_voices_active(), 0);

    // the zero-copy entry point: PCM already in the device's format
    let rawid: i32 = register_raw_and_drop(2205, 2500);
    ok("audio_register_pcm (zero copy) registered a dropped-handle buffer",
       rawid >= 0);
    eq("its chunk is live", audio_sound_ready(rawid), 1);
    eq("zero copy: device bytes == source bytes", audio_sound_bytes(rawid), 4410);
    churn(8);
    // 2500 = 0x09C4, so byte 0 is 0xC4 = 196 and byte 1 is 0x09 = 9.
    eq("the zero-copy buffer survives churn", audio_sound_byte(rawid, 0), 196);
    ok("the zero-copy sound plays", audio_play(rawid, 1.0) >= 0);
    audio_stop_all();

    // ---- voices ----------------------------------------------------------
    print("");
    print("--- E. voice accounting and stealing ---");
    audio_reset_counters();
    let long_id: i32 = register_and_drop(22050 * 2, 2000);   // 2 s
    ok("registered a 2 s sound", long_id >= 0);
    let v: i32 = 0;
    let started: i32 = 0;
    let distinct: i32 = 1;
    let seen = [];
    while (v < 8) {
        let c: i32 = audio_play_panned(long_id, 0.5, -1.0 + f64(v) * 0.2857);
        if (c >= 0) { started = started + 1; }
        let k: i32 = 0;
        while (k < seen.length) {
            if (seen[k] == c) { distinct = 0; }
            k++;
        }
        seen.push(c);
        v++;
    }
    eq("8 plays all got a voice", started, 8);
    eq("all 8 voices are distinct", distinct, 1);
    eq("8 voices are sounding simultaneously", audio_voices_active(), 8);
    eq("nothing was dropped", audio_drops_total(), 0);
    eq("nothing was stolen (8 of 16)", audio_steals_total(), 0);
    eq("the play counter agrees", audio_plays_total(), 8);
    // fill the remaining 8, then force stealing
    let w: i32 = 0;
    while (w < 8) { audio_play(long_id, 0.4); w++; }
    eq("all 16 voices are sounding", audio_voices_active(), 16);
    eq("still nothing stolen at exactly 16", audio_steals_total(), 0);
    let stolen_ch: i32 = audio_play(long_id, 0.4);
    ok("the 17th play still gets a voice (oldest is stolen)", stolen_ch >= 0);
    eq("exactly one steal was recorded", audio_steals_total(), 1);
    eq("it stole the oldest voice", stolen_ch, seen[0]);
    eq("still 16 voices sounding, no dropout", audio_voices_active(), 16);
    eq("no play was dropped", audio_drops_total(), 0);
    audio_stop_voice(stolen_ch);
    eq("audio_stop_voice freed one voice", audio_voices_active(), 15);
    audio_stop_all();
    eq("audio_stop_all cleared them", audio_voices_active(), 0);

    // ---- volume ----------------------------------------------------------
    print("");
    print("--- F. volume and looping ---");
    audio_set_volume(0.5);
    ok("audio_set_volume round-trips", audio_get_volume() == 0.5);
    audio_set_volume(4.0);
    ok("audio_set_volume clamps above 1.0", audio_get_volume() == 1.0);
    audio_set_volume(0.0 - 1.0);
    ok("audio_set_volume clamps below 0.0", audio_get_volume() == 0.0);
    audio_set_volume(1.0);
    ok("audio_set_sound_volume returns the previous chunk volume",
       audio_set_sound_volume(sid, 0.5) >= 0);
    eq("audio_set_sound_volume rejects an unknown id",
       audio_set_sound_volume(9999, 0.5), 0 - 1);
    let lch: i32 = audio_play_looped(sid, 0.3, 0.0, AUDIO_LOOP_FOREVER);
    ok("a looping voice starts", lch >= 0);
    clock_sleep_ms(30);
    eq("the looping voice is still sounding", audio_voices_active(), 1);
    audio_stop_all();
    eq("and stops on demand", audio_voices_active(), 0);
    eq("an unknown sound id is dropped, not fatal", audio_play(9999, 1.0), 0 - 1);
    eq("a negative sound id is dropped, not fatal", audio_play(0 - 5, 1.0), 0 - 1);

    // ---- per-frame cost --------------------------------------------------
    print("");
    print("--- G. per-frame Hemlock cost ---");
    audio_reset_counters();
    let frames: i32 = 1000;
    let t0: u64 = clock_now();
    let f: i32 = 0;
    while (f < frames) {
        // a heavy but realistic frame: 4 new panned voices + the HUD query
        audio_play_panned(sid, 0.5, 0.0 - 0.8);
        audio_play_panned(sid, 0.5, 0.0 - 0.2);
        audio_play_panned(sid, 0.5, 0.35);
        audio_play_panned(sid, 0.5, 0.9);
        audio_voices_active();
        f++;
    }
    let t1: u64 = clock_now();
    let per_frame: f64 = clock_ms_between(t0, t1) / f64(frames);
    note(`4 panned plays + 1 voice query per frame, x1000 : ${per_frame} ms/frame`);
    note(`  plays=${audio_plays_total()} drops=${audio_drops_total()} steals=${audio_steals_total()}`);
    ok(`per-frame audio cost is <= ${ms_limit} ms`, per_frame <= ms_limit);
    audio_stop_all();

    // ---- soak ------------------------------------------------------------
    print("");
    print("--- H. allocation soak ---");
    audio_reset_counters();
    let rss0: i32 = rss_kb();
    let soak_frames: i32 = 20000;
    if (soak_s > 0) {
        note(`--soak ${soak_s}s requested`);
    }
    let sf: i32 = 0;
    while (sf < soak_frames) {
        audio_play_panned(sid, 0.25, 0.0 - 0.5 + f64(sf % 5) * 0.25);
        audio_voices_active();
        audio_report_string();      // deliberately allocates a string every frame
        sf++;
    }
    let rss1: i32 = rss_kb();
    note(`20 000-frame soak: RSS ${rss0} KB -> ${rss1} KB (delta ${rss1 - rss0} KB)`);
    ok(`RSS growth over 20 000 audio frames is under ${rss_limit} KB`,
       rss1 - rss0 < rss_limit);
    eq("nothing was dropped during the soak", audio_drops_total(), 0);
    audio_stop_all();
    audio_shutdown();
    eq("audio_ready() is 0 after shutdown", audio_ready(), 0);
    eq("chunks are released, so a play after shutdown is a counted drop",
       audio_play(sid, 1.0), 0 - 1);
    eq("the PCM registry still owns every buffer after shutdown",
       audio_sound_byte(sid, 0), 184);
    eq("and still knows how many sounds it has", audio_sound_count(), 4);
    eq("audio_ready() is 0 after the second shutdown", audio_ready(), 0);

    // =======================================================================
    print("");
    print("--- I. stereo device: panning is real, and 8 pans are distinct ---");
    // =======================================================================
    // SDL's `disk` audio driver writes the mixer's own output to a file, which
    // is the only way to assert what actually came out. Its pacing is the
    // device period, so the capture is real-time.
    SDL_QuitSubSystem(SDL_INIT_AUDIO_FLAG);
    setenv("SDL_AUDIODRIVER", "disk");
    setenv("SDL_DISKAUDIOFILE", cap1);
    let r2: i32 = audio_init(AUDIO_DEFAULT_FREQ, AUDIO_FMT_S16, 2,
                             AUDIO_DEFAULT_CHUNK, AUDIO_DEFAULT_VOICES);
    eq("a stereo device opened", r2, 1);
    eq("obtained channel count is 2", audio_out_channels(), 2);
    eq("audio_can_pan() now reports 1", audio_can_pan(), 1);
    // audio_init re-expanded every mono sound for the new channel count.
    eq("the mono sound was re-expanded to stereo",
       audio_sound_bytes(sid), nsamp * 2 * 2);
    eq("its chunk was rebuilt", audio_sound_ready(sid), 1);
    note(`stereo device: ${audio_report_string()}`);

    eq("the mixer is really running on SDL's disk driver",
       SDL_GetCurrentAudioDriver(), "disk");
    audio_play_panned(sid, 1.0, 0.0 - 1.0);      // hard left
    clock_sleep_ms(260);
    audio_stop_all();
    audio_hard_reset();
    let n1: i32 = capture_read(cap1);
    ok("captured the hard-left mix", n1 > 0);
    let el: i64 = cap_energy(0);
    let er: i64 = cap_energy(1);
    note(`hard left  : ${n1} bytes, L energy ${el}, R energy ${er}`);
    ok("hard left puts energy in the left channel", el > 0);
    eq("hard left puts EXACTLY ZERO in the right channel", er, 0);
    let gap1: i32 = cap_gap_run();
    note(`  longest interior silent run ${gap1} frames, total ${g_gap_total}`);
    eq("no interior dropout in the hard-left capture", gap1, 0);

    setenv("SDL_DISKAUDIOFILE", cap2);
    let r3: i32 = audio_init(AUDIO_DEFAULT_FREQ, AUDIO_FMT_S16, 2,
                             AUDIO_DEFAULT_CHUNK, AUDIO_DEFAULT_VOICES);
    eq("the stereo device reopened", r3, 1);
    audio_play_panned(sid, 1.0, 1.0);            // hard right
    clock_sleep_ms(260);
    audio_stop_all();
    audio_hard_reset();
    let n2: i32 = capture_read(cap2);
    ok("captured the hard-right mix", n2 > 0);
    let el2: i64 = cap_energy(0);
    let er2: i64 = cap_energy(1);
    note(`hard right : ${n2} bytes, L energy ${el2}, R energy ${er2}`);
    ok("hard right puts energy in the right channel", er2 > 0);
    eq("hard right puts EXACTLY ZERO in the left channel", el2, 0);
    let gap2: i32 = cap_gap_run();
    note(`  longest interior silent run ${gap2} frames, total ${g_gap_total}`);
    eq("no interior dropout in the hard-right capture", gap2, 0);

    // ---- the headline criterion -----------------------------------------
    setenv("SDL_DISKAUDIOFILE", cap3);
    let r4: i32 = audio_init(AUDIO_DEFAULT_FREQ, AUDIO_FMT_S16, 2,
                             AUDIO_DEFAULT_CHUNK, AUDIO_DEFAULT_VOICES);
    eq("the stereo device reopened again", r4, 1);
    audio_reset_counters();
    let p: i32 = 0;
    let pans_distinct: i32 = 1;
    let pseen = [];
    while (p < 8) {
        let pan: f64 = 0.0 - 1.0 + f64(p) * 0.2857142857;
        let c2: i32 = audio_play_panned(sid, 0.4, pan);
        let q: i32 = 0;
        while (q < pseen.length) { if (pseen[q] == c2) { pans_distinct = 0; } q++; }
        pseen.push(c2);
        p++;
    }
    eq("8 voices started on a stereo device", audio_plays_total(), 8);
    eq("on 8 distinct channels", pans_distinct, 1);
    eq("8 voices sounding simultaneously", audio_voices_active(), 8);
    eq("no drops", audio_drops_total(), 0);
    eq("no steals", audio_steals_total(), 0);
    clock_sleep_ms(260);
    audio_stop_all();
    audio_hard_reset();
    let n3: i32 = capture_read(cap3);
    ok("captured the 8-voice mix", n3 > 0);
    let el3: i64 = cap_energy(0);
    let er3: i64 = cap_energy(1);
    let gaps3: i32 = cap_gap_run();
    note(`8 voices   : ${n3} bytes, L energy ${el3}, R energy ${er3}, longest interior silent run ${gaps3} frames, total ${g_gap_total}`);
    ok("both channels carry the 8-voice mix", el3 > 0 && er3 > 0);
    // One device period is 512 frames (23 ms). A run below 64 frames (2.9 ms)
    // cannot be an underrun; it is eight identical waveforms cancelling.
    ok("NO DROPOUT: longest interior silent run is far under one device period",
       gaps3 >= 0 && gaps3 < 64);
    // The pans are symmetric about centre, so the two channels should be close
    // in total energy but not identical (the voices are staggered in time).
    ok("the 8 symmetric pans balance the two channels within 25 %",
       el3 * 4 > er3 * 3 && er3 * 4 > el3 * 3);

    unsetenv("SDL_AUDIODRIVER");
    unsetenv("SDL_DISKAUDIOFILE");
    if (exists(cap1)) { remove_file(cap1); }
    if (exists(cap2)) { remove_file(cap2); }
    if (exists(cap3)) { remove_file(cap3); }

    // =======================================================================
    // optional long soak
    // =======================================================================
    let expected: i32 = BASE_ASSERTIONS;
    if (soak_s > 0) {
        expected = BASE_ASSERTIONS + SOAK_ASSERTIONS;
        print("");
        print(`--- J. ${soak_s} s soak ---`);
        SDL_QuitSubSystem(SDL_INIT_AUDIO_FLAG);
        setenv("SDL_AUDIODRIVER", "dummy");
        let rs: i32 = audio_init(AUDIO_DEFAULT_FREQ, AUDIO_FMT_S16, 2,
                                 AUDIO_DEFAULT_CHUNK, AUDIO_DEFAULT_VOICES);
        ok("soak device opened", rs == 1);
        audio_reset_counters();
        let base: i32 = 0;
        let g0: u64 = clock_now();
        let elapsed: f64 = 0.0;
        let it: i32 = 0;
        let rmin: i32 = 0;
        let rmax: i32 = 0;
        // MEASURED WALL, and the reason this loop is throttled:
        // at full speed this block issues ~300 000 plays/second, and at
        // EXACTLY 74 016 000 plays (reproduced to the play in two independent
        // 600 s runs) the Hemlock RUNTIME raises "Maximum call stack depth
        // exceeded" even though nothing here recurses and the call depth never
        // exceeds 4. 74 016 000 x 29 Hemlock calls per frame = 2 146 464 000,
        // which is 2^31 to within 0.05 %, so it is 32-bit call accounting in
        // the runtime, not this code. It is reported, not worked around.
        // 10 ms per 600-frame block keeps the soak near 50 000 plays/second —
        // still ~200x a real 60 Hz frame's audio load — and well under the wall.
        let play_cap: i32 = 40000000;
        while (elapsed < f64(soak_s) * 1000.0 && audio_plays_total() < play_cap) {
            let fi: i32 = 0;
            while (fi < 600) {           // ~10 s of frames at 60 Hz per block
                audio_play_panned(sid, 0.2, 0.0 - 1.0 + f64(fi % 9) * 0.25);
                audio_voices_active();
                audio_report_string();
                fi++;
            }
            clock_sleep_ms(10);
            let rnow: i32 = rss_kb();
            if (it == 0) { base = rnow; rmin = rnow; rmax = rnow; }
            if (rnow < rmin) { rmin = rnow; }
            if (rnow > rmax) { rmax = rnow; }
            it++;
            elapsed = clock_ms_between(g0, clock_now());
            if (it % 60 == 0) {
                print(`  t=${i32(elapsed / 1000.0)}s  rss=${rnow} KB  plays=${audio_plays_total()}`);
            }
        }
        let rend: i32 = rss_kb();
        note(`soak ${soak_s}s: ${it} blocks, ${audio_plays_total()} plays over ${i32(elapsed / 1000.0)}s, RSS base ${base} KB min ${rmin} max ${rmax} end ${rend} KB`);
        if (audio_plays_total() >= play_cap) {
            note("soak stopped on the play cap, not on the clock");
        }
        ok("RSS is flat over the soak (end - base < 2 MB)", rend - base < 2048);
        audio_stop_all();
        audio_shutdown();
    }

    // =======================================================================
    print("");
    print("--- notes ---");
    let ni: i32 = 0;
    while (ni < g_notes.length) { print(`  ${g_notes[ni]}`); ni++; }
    print("");
    if (g_n != expected) {
        print(`FAIL assertion count: ran ${g_n}, expected ${expected} — a branch was skipped`);
        exit(1);
    }
    if (g_pass == g_n) { print(`PASS ${g_pass}/${g_n}`); }
    else {
        print(`FAIL ${g_pass}/${g_n}`);
        exit(1);
    }
}

main();
